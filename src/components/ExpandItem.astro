---
import { ICONS, type IconKey } from '../lib/icons';
// One row of the Research or Projects index: a summary line that expands in
// place to show more, with a "Dig deeper" link to the full page. Built on
// <details>, so it works without JavaScript and with the keyboard.

interface Props {
  href: string;
  title: string;
  subtitle: string;
  icon?: IconKey;
  thumbnail?: string;
  /** Open on page load. */
  open?: boolean;
}

const { href, title, subtitle, icon = 'code', thumbnail, open = false } = Astro.props;
---

<details class="r-item" open={open}>
  <summary class="r-head">
    <span class="r-thumb" aria-hidden="true">
      {thumbnail ? (
        <img src={thumbnail} alt="" width="64" height="64" loading="lazy" />
      ) : (
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={(ICONS[icon] ?? ICONS.code).paths} />
      )}
    </span>
    <span class="r-main">
      <slot name="tags" />
      <span class="r-title">{title}</span>
      <span class="r-sub">{subtitle}</span>
    </span>
    <span class="r-caret" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"/></svg>
    </span>
  </summary>
  <div class="r-expand-inner">
    <slot />
    <div class="actions">
      <a class="btn" href={href}>
        Dig deeper
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <slot name="actions" />
    </div>
  </div>
</details>

<style>
  .r-item {
    border-top: 1px solid var(--border);
    padding: 22px 0;
  }
  .r-item:last-of-type {
    border-bottom: 1px solid var(--border);
  }
  .r-head {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    cursor: pointer;
    list-style: none;
    border-radius: calc(6px * var(--round, 1));
  }
  .r-head::-webkit-details-marker {
    display: none;
  }
  .r-thumb {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: calc(10px * var(--round, 1));
    border: 1px solid transparent;
    background: var(--accent-wash);
    display: grid;
    place-items: center;
    color: var(--accent-ink);
    overflow: hidden;
  }
  .r-thumb:has(img) {
    border-color: var(--border);
    background: var(--surface-2);
  }
  .r-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .r-main {
    flex: 1;
    min-width: 0;
    display: block;
  }
  .r-title {
    display: block;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: var(--heading-weight);
    color: var(--ink);
    margin-bottom: 4px;
  }
  .r-head:hover .r-title {
    color: var(--accent-ink);
  }
  .r-sub {
    display: block;
    font-size: 14px;
    color: var(--ink-2);
  }
  .r-caret {
    flex: none;
    color: var(--ink-3);
    transition: transform .25s;
    margin-top: 4px;
  }
  .r-item[open] .r-caret {
    transform: rotate(90deg);
  }
  .r-expand-inner {
    padding: 16px 0 4px 82px;
  }
  .r-item[open] .r-expand-inner {
    animation: reveal .3s ease;
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .r-expand-inner :global(p) {
    margin: 0 0 14px;
    color: var(--ink-2);
    font-size: 15px;
    max-width: 62ch;
  }
  @media (max-width: 560px) {
    .r-head {
      gap: 14px;
    }
    .r-thumb {
      width: 48px;
      height: 48px;
    }
    .r-expand-inner {
      padding-left: 0;
    }
  }
</style>
