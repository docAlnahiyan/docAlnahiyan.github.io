---
// One row of the Research or Projects index: a summary line that expands in
// place to show more, with a "Dig deeper" link to the full page. Built on
// <details>, so it works without JavaScript and with the keyboard.

interface Props {
  href: string;
  title: string;
  subtitle: string;
  icon?: 'brain' | 'slices' | 'code';
  thumbnail?: string;
  /** Open on page load. */
  open?: boolean;
}

const { href, title, subtitle, icon = 'code', thumbnail, open = false } = Astro.props;
---

<details class="r-item" open={open}>
  <summary class="r-head">
    <span class="r-thumb" aria-hidden="true">
      {thumbnail ? (
        <img src={thumbnail} alt="" width="64" height="64" loading="lazy" />
      ) : icon === 'brain' ? (
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c4.5 0 7 3 7 7 0 2-1 3.5-1 5s1 2 1 3c0 1.5-1.5 3-4 3-1 0-1.8-.5-3-.5s-2 .5-3 .5c-2.5 0-4-1.5-4-3 0-1 1-1.5 1-3s-1-3-1-5c0-4 2.5-7 7-7Z"/><path d="M12 7v10M8.5 10.5h7M9 14h6"/></svg>
      ) : icon === 'slices' ? (
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 9h16M9 9v11"/></svg>
      ) : (
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/></svg>
      )}
    </span>
    <span class="r-main">
      <slot name="tags" />
      <span class="r-title">{title}</span>
      <span class="r-sub">{subtitle}</span>
    </span>
    <span class="r-caret" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"/></svg>
    </span>
  </summary>
  <div class="r-expand-inner">
    <slot />
    <div class="actions">
      <a class="btn" href={href}>
        Dig deeper
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <slot name="actions" />
    </div>
  </div>
</details>

<style>
  .r-item {
    border-top: 1px solid var(--border);
    padding: 22px 0;
  }
  .r-item:last-of-type {
    border-bottom: 1px solid var(--border);
  }
  .r-head {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }
  .r-head::-webkit-details-marker {
    display: none;
  }
  .r-thumb {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    display: grid;
    place-items: center;
    color: var(--accent);
    overflow: hidden;
  }
  .r-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .r-main {
    flex: 1;
    min-width: 0;
    display: block;
  }
  .r-title {
    display: block;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .r-head:hover .r-title {
    color: var(--accent-ink);
  }
  .r-sub {
    display: block;
    font-size: 14px;
    color: var(--ink-2);
  }
  .r-caret {
    flex: none;
    color: var(--ink-3);
    transition: transform .25s;
    margin-top: 4px;
  }
  .r-item[open] .r-caret {
    transform: rotate(90deg);
  }
  .r-expand-inner {
    padding: 16px 0 4px 82px;
  }
  .r-item[open] .r-expand-inner {
    animation: reveal .3s ease;
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .r-expand-inner :global(p) {
    margin: 0 0 14px;
    color: var(--ink-2);
    font-size: 15px;
    max-width: 62ch;
  }
  @media (max-width: 560px) {
    .r-head {
      gap: 14px;
    }
    .r-thumb {
      width: 48px;
      height: 48px;
    }
    .r-expand-inner {
      padding-left: 0;
    }
  }
</style>
