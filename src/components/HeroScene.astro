---
// Animated landing hero (design-reference/landing-scene-spec.md). A stack of
// layers in one box: decorative SVG for the sketch, real HTML for the name,
// bio and (later) the road signposts, so text and links work for search,
// keyboard and screen readers without the drawing.
interface Props {
  name: string;
  /** One line under the name; the only place the university is named in the hero. */
  bio: string;
}

const { name, bio } = Astro.props;

// Back to front (spec §3). scene.ts sizes and fills each one. The dense
// static layers come in a day and a night copy, crossfaded by the theme.
const layers = [
  { name: 'sky' },
  { name: 'birds' },
  { name: 'land', tone: 'day' },
  { name: 'land', tone: 'night' },
  { name: 'water' },
  { name: 'road', tone: 'day' },
  { name: 'road', tone: 'night' },
  { name: 'orbit' },
  { name: 'characters' },
];

// One per mountain peak, left to right. The positions are where they land on
// a 1440 × 900 screen, used until the script places them exactly.
const peakLinks = [
  { label: 'Research', href: '/research/', left: '47%', top: '60%' },
  { label: 'Publications', href: '/publications/', left: '66%', top: '55%' },
  { label: 'Projects', href: '/projects/', left: '84%', top: '54%' },
];
---

<section class="scene" id="hero" aria-labelledby="hero-name">
  {layers.map((layer) => (
    <svg
      class={`layer layer-${layer.name}`}
      data-layer={layer.name}
      data-tone={layer.tone}
      aria-hidden="true"
      focusable="false"
    />
  ))}

  {/* Bonus path to three pages (spec §4.9); the header nav always has them.
       scene.ts places each on its mountain peak and draws its placard. */}
  <nav class="peaks" aria-label="Explore">
    {peakLinks.map((l) => (
      <a class="peak-link" href={l.href} style={`left:${l.left};top:${l.top}`}>
        <svg class="peak-bg" aria-hidden="true" focusable="false" preserveAspectRatio="none" />
        <span>{l.label}</span>
      </a>
    ))}
  </nav>

  <div class="text">
    <h1 id="hero-name" class="name">{name}</h1>
    <p class="bio">{bio}</p>
  </div>
</section>

<script>
  import { drawScene, onResize } from './hero/scene';
  import { explorer, repelText, startLoop } from './hero/motion';

  const hero = document.getElementById('hero');
  if (hero) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let geo = drawScene(hero);
    const redraw = () => {
      geo = drawScene(hero);
      hero.dispatchEvent(new Event('hero:drawn'));
      apply();
    };
    onResize(hero, redraw);

    // With reduced motion the scene stays still: the text is plain, the
    // explorer stands on the road and the mountain buttons are plain links.
    let setLoop: ((running: boolean) => void) | undefined;
    if (!reduced.matches) {
      const text = [...hero.querySelectorAll<HTMLElement>('.name, .bio')];
      setLoop = startLoop(hero, [
        repelText(hero, text, () => hero.querySelectorAll('.fly path')),
        explorer(hero, () => geo),
      ]);
    }

    // Everything moves only while it can be seen: not with reduced motion,
    // not in a hidden tab, not with the hero scrolled out of view. That
    // covers the motion loop, the CSS animations and the SMIL ones (sun
    // rays, orbit, wing flaps), which CSS alone cannot stop.
    let inView = true;
    function apply() {
      const running = !reduced.matches && !document.hidden && inView;
      hero!.classList.toggle('paused', !running);
      hero!.querySelectorAll<SVGSVGElement>('svg[data-layer]').forEach((svg) => {
        if (running) {
          svg.unpauseAnimations();
          return;
        }
        svg.pauseAnimations();
        // With reduced motion, hold the composed starting pose.
        if (reduced.matches) svg.setCurrentTime(0);
      });
      setLoop?.(running);
    }
    document.addEventListener('visibilitychange', apply);
    reduced.addEventListener('change', apply);
    // The sticky nav covers the top of the window, so a hero only showing
    // behind it counts as out of view.
    const navH = document.getElementById('site-nav')?.offsetHeight ?? 0;
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        apply();
      },
      { rootMargin: `-${navH}px 0px 0px 0px` },
    ).observe(hero);
    apply();
  }
</script>

<style>
  /* Scene colours (spec §2) and day/night switches, per theme. scene.ts
     draws with these variables, so a theme switch only changes them; the
     transition rule in global.css then eases everything across together. */
  .scene {
    --sk-night: 0;
    --sk-day: 1;
    --sk-day-delay: 0s;
    --sk-glow: 0;
    --sk-char: #c96442;
    --sk-mtn: #6f9b57;
    --sk-mtnO: #4f7540;
    --sk-road: #9c7a52;
    --sk-washTop: #bfe6fb;
    --sk-washBot: #4fbfed;
    --sk-flow: #1f9fe0;
    --sk-sun: #e8954a;
    --sk-moon: #e7dcc6;
    --sk-star: #9a9280;
    --sk-brain: #a8482b;
    --sk-book: #5c584f;
    --sk-bird: #8a8378;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .scene {
      --sk-night: 1;
      --sk-day: 0;
      --sk-day-delay: .5s;
      --sk-glow: 1;
      --sk-char: #e8a07f;
      --sk-mtn: #5a7d4e;
      --sk-mtnO: #7fa86d;
      --sk-road: #7a5f45;
      --sk-washTop: #1f3a4d;
      --sk-washBot: #13303f;
      --sk-flow: #49a7da;
      --sk-sun: #e8a54a;
      --sk-moon: #f0e7d6;
      --sk-star: #f3eee4;
      --sk-brain: #ea9c7e;
      --sk-book: #c7c0b2;
      --sk-bird: #f4f1ea;
    }
  }
  :global(:root[data-theme='dark']) .scene {
    --sk-night: 1;
    --sk-day: 0;
    --sk-day-delay: .5s;
    --sk-glow: 1;
    --sk-char: #e8a07f;
    --sk-mtn: #5a7d4e;
    --sk-mtnO: #7fa86d;
    --sk-road: #7a5f45;
    --sk-washTop: #1f3a4d;
    --sk-washBot: #13303f;
    --sk-flow: #49a7da;
    --sk-sun: #e8a54a;
    --sk-moon: #f0e7d6;
    --sk-star: #f3eee4;
    --sk-brain: #ea9c7e;
    --sk-book: #c7c0b2;
    --sk-bird: #f4f1ea;
  }

  /* Day and night skies are stacked; the night one fades in over the day.
     Sun and moon, stars and the birds' glow follow the same switches. */
  .scene::before,
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .scene::before {
    background: linear-gradient(180deg, #fbeede, #f6ead5);
  }
  .scene::after {
    background: linear-gradient(180deg, #141821, #1f2430);
    opacity: var(--sk-night);
    /* Its own GPU layer, so the fade doesn't repaint the sky every frame. */
    will-change: opacity;
  }
  .scene :global(.day-only) {
    opacity: var(--sk-day);
  }
  .scene :global(.night-only) {
    opacity: var(--sk-night);
  }
  /* The night copy of the land and road fades in over the day copy. The day
     copy only hides once the night one is fully in (and reappears at once on
     the way back), so the sky never shows through mid-fade. */
  .layer[data-tone='night'] {
    opacity: var(--sk-night);
  }
  .layer[data-tone='day'] {
    opacity: var(--sk-day);
  }
  /* Only the scene's day/night parts fade by opacity (global.css eases the
     colours everywhere). */
  :global(.theme-anim) .scene::after,
  :global(.theme-anim) .scene :global(.day-only),
  :global(.theme-anim) .scene :global(.night-only),
  :global(.theme-anim) .layer[data-tone='night'] {
    transition-property: opacity !important;
  }
  :global(.theme-anim) .layer[data-tone='day'] {
    transition: opacity 0s linear var(--sk-day-delay, 0s) !important;
  }

  .scene {
    position: relative;
    overflow: hidden;
    /* 85% of the screen (never under 560px), so the next section peeks up
       from below. svh ignores the phone address bar, so the scene does not
       jump while scrolling. */
    height: max(560px, 85vh);
    height: max(560px, 85svh);
    border-bottom: 1px solid var(--border);
  }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .layer-sky { z-index: 1; }
  .layer-birds { z-index: 2; }
  .layer-land { z-index: 3; }
  .layer-water { z-index: 4; }
  .layer-road { z-index: 5; }
  /* The dense static layers get their own compositing layer, so the motion
     around them never makes the browser repaint their thousands of dots. */
  .layer-land,
  .layer-road {
    will-change: transform, opacity;
  }
  .layer-orbit { z-index: 6; }
  .layer-characters { z-index: 7; }

  /* Paused while hidden, scrolled away or with reduced motion (see the
     script); this holds the CSS animations where they are. */
  .scene.paused :global(*) {
    animation-play-state: paused !important;
  }

  /* Motion (ported from the element library). Drawn elements are created by
     the script, so these rules are global within the scene. The site-wide
     reduced-motion rule turns them all off. */
  .scene :global(.flow) {
    animation: flow linear infinite;
  }
  @keyframes flow {
    /* 20 dots of 14px, so the loop has no visible seam. */
    to { stroke-dashoffset: -280; }
  }
  .scene :global(.glow) {
    animation: glow 5s ease-in-out infinite;
  }
  @keyframes glow {
    0%, 100% { opacity: .45; }
    50% { opacity: .92; }
  }
  .scene :global(.tw) {
    animation: twinkle ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: .2; }
    50% { opacity: 1; }
  }

  /* Birds and boat cross the full width; scene.ts sets --from and --to in
     pixels for the current hero size. With reduced motion they rest at the
     position given in their transform attribute. */
  .scene :global(.fly) {
    animation: cross 24s linear infinite;
  }
  .scene :global(.sail) {
    animation: cross 24s linear infinite;
  }
  @keyframes cross {
    from { transform: translate(var(--from)); }
    to { transform: translate(var(--to)); }
  }
  .scene :global(.rock) {
    animation: rock 3.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes rock {
    0%, 100% { transform: translateY(0) rotate(-1.6deg); }
    50% { transform: translateY(-2px) rotate(1.6deg); }
  }

  /* Mountain nav buttons: real links over the scene, each with a rough
     placard (drawn by scene.ts) behind its label. */
  .peaks {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }
  .peak-link {
    position: absolute;
    transform: translate(-50%, -50%);
    isolation: isolate;
    /* In em, so the placard grows and shrinks with the font size that
       scene.ts sets from the scene scale. */
    padding: .4em 1.04em;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent-ink);
    white-space: nowrap;
    pointer-events: auto;
  }
  .peak-link[hidden] {
    display: none;
  }
  .peak-link:hover,
  .peak-link:focus-visible {
    text-decoration: none;
    color: var(--accent);
  }
  .peak-link:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .peak-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* rough.js draws the fill first, then the outline. */
  .peak-bg :global(path:first-child) {
    fill: var(--surface);
    stroke: none;
  }
  .peak-bg :global(path:last-child) {
    stroke: var(--accent-ink);
  }
  .peak-link:hover .peak-bg :global(path:first-child),
  .peak-link:focus-visible .peak-bg :global(path:first-child) {
    fill: var(--accent-wash);
  }
  .peak-link:hover .peak-bg :global(path:last-child),
  .peak-link:focus-visible .peak-bg :global(path:last-child) {
    stroke: var(--accent);
  }

  /* The ring that spreads where the explorer dives into a button. */
  .scene :global(.ripple) {
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 2.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: ripple .6s ease-out forwards;
  }
  @keyframes ripple {
    from { transform: scale(.12); opacity: .85; }
    to { transform: scale(1); opacity: 0; }
  }

  /* Name and bio, upper left, with no card behind them (spec §4.13).
     scene.ts sets the position and sizes from the scene scale, so they stay
     in proportion with the drawing; the fallbacks apply without JavaScript. */
  .text {
    position: absolute;
    z-index: 8;
    left: var(--text-left, 6%);
    top: var(--text-top, 15%);
    width: var(--text-width, 88%);
    pointer-events: none;
  }
  /* Letters made by the repel script (motion.ts). Words stay whole, so
     lines only break at spaces. */
  .text :global(.word) {
    white-space: nowrap;
  }
  .text :global(.ch) {
    display: inline-block;
    will-change: transform;
  }
  .text :global(.ch)::before {
    content: attr(data-ch);
  }
  .name {
    font-size: var(--name-size, clamp(34px, 4.6vw, 64px));
    letter-spacing: -.02em;
    line-height: 1.05;
    margin: 0 0 .22em;
  }
  .bio {
    font-family: var(--font-mono);
    font-size: var(--bio-size, 14px);
    color: var(--ink-2);
    max-width: 46ch;
    margin: 0;
  }
</style>
