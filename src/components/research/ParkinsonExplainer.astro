---
// Six-stage scroll explainer for the 2D Parkinson's paper, ported from
// design-reference/parkinson-explainer-v2.html (spec: parkinson-page-spec.md).
// The brain shown throughout is the open MNI152 template, not patient data.
//
// Pipeline, architecture and benchmark figures follow the paper. The Stage 6
// probabilities are example outputs, not from specific scans.

const MRI = '/research/parkinson/mri';
const slice = (i: number) => `${MRI}/slice_${String(i).padStart(2, '0')}.png`;
const MIDDLE = 6;

// Fixed-seed random numbers, so every build draws the same decoration.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const stages = [
  { id: 's1', rail: 'Data' },
  { id: 's2', rail: 'One scan' },
  { id: 's3', rail: 'Preprocess' },
  { id: 's4', rail: 'CNN' },
  { id: 's5', rail: 'Transformer' },
  { id: 's6', rail: 'Prediction' },
];

const cohorts = [
  { c: 'ctl', name: 'Control', desc: "No Parkinson's. The healthy baseline." },
  { c: 'prod', name: 'Prodromal', desc: 'Early, at-risk stage — before clinical diagnosis.' },
  { c: 'pd', name: "Parkinson's (PD)", desc: "Clinically diagnosed Parkinson's disease." },
];

// Stage 2: seven slices from the middle of the stack, fanned out.
const volume = [3, 4, 5, 6, 7, 8, 9].map((n, i) => ({
  src: slice(n),
  style: `top:${i * 5}px;left:${i * 4}px;opacity:${(0.55 + i * 0.064).toFixed(2)};background-image:url('${slice(n)}')`,
}));

const preprocess = [
  { cls: 'm-reg', cap: 'Register → MNI PD25' },
  { cls: '', cap: 'Middle axial slice' },
  { cls: 'm-resize', cap: 'Resize 224×224' },
  { cls: 'm-norm', cap: 'Normalize µ=0.5, σ=0.5' },
  { cls: 'm-aug', cap: 'Augment (train)' },
];

// Stage 4: the standard ResNet18 stages. s = front-face size, cells = grid
// per side (spatial), depth = stacked slices (channels). Drawn by the script.
const maps = [
  { s: 74, cells: 7, depth: 1, d: '224² · 3ch', l: 'input' },
  { s: 64, cells: 6, depth: 2, d: '56² · 64', l: 'conv1' },
  { s: 54, cells: 5, depth: 3, d: '28² · 128', l: 'block2' },
  { s: 44, cells: 4, depth: 4, d: '14² · 256', l: 'block3' },
  { s: 34, cells: 3, depth: 5, d: '7² · 512', l: 'block4' },
];

// SVG helpers for the two diagrams below, built once at build time.
// Colours go in style="" so the site's day/night tokens apply.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const el = (n: string, a: Record<string, string | number>, style = '', text?: string) => {
  const attrs = Object.entries(a).map(([k, v]) => ` ${k}="${v}"`).join('');
  const st = style ? ` style="${style}"` : '';
  return text == null ? `<${n}${attrs}${st}/>` : `<${n}${attrs}${st}>${esc(text)}</${n}>`;
};

// Stage 5: the Transformer encoder diagram (680 × 510).
function encoderSvg() {
  const out: string[] = [];
  const box = (x: number, y: number, w: number, h: number, o: { r?: number; fill?: string; stroke?: string; sw?: number } = {}) =>
    out.push(el('rect', { x, y, width: w, height: h, rx: o.r ?? 7 },
      `fill:${o.fill ?? 'var(--surface)'};stroke:${o.stroke ?? 'var(--border)'};stroke-width:${o.sw ?? 1.2}`));
  const tx = (x: number, y: number, t: string, o: { a?: string; fs?: number; fill?: string; ff?: string; fw?: number } = {}) =>
    out.push(el('text', { x, y, 'text-anchor': o.a ?? 'middle', 'font-size': o.fs ?? 11, 'font-weight': o.fw ?? 400 },
      `fill:${o.fill ?? 'var(--ink)'};font-family:${o.ff ?? 'var(--font-body)'}`, t));
  const arr = (x: number, y1: number, y2: number) =>
    out.push(el('line', { x1: x, y1, x2: x, y2, 'stroke-width': 1.3, 'marker-end': 'url(#txah)' }, 'stroke:var(--ink-3)'));
  out.push('<defs><marker id="txah" markerWidth="7" markerHeight="7" refX="5.5" refY="3" orient="auto">' +
    el('path', { d: 'M0,0 L6,3 L0,6 Z' }, 'fill:var(--ink-3)') + '</marker></defs>');

  // Input tokens + positional encoding.
  tx(205, 16, 'From CNN · 7×7×512 → 49 tokens (d = 512)', { fs: 10.5, fill: 'var(--ink-2)' });
  for (let k = 0; k < 10; k++)
    out.push(el('rect', { x: 70 + k * 27, y: 26, width: 16, height: 22, rx: 3, opacity: (0.4 + rand() * 0.5).toFixed(2) }, 'fill:var(--ctrl)'));
  tx(205, 62, '+ positional encoding', { fs: 9.5, fill: 'var(--ink-3)', ff: 'var(--font-mono)' });
  arr(205, 68, 86);

  // Encoder block, stacked × 6.
  box(48, 98, 316, 214, { fill: 'var(--surface-2)' });
  box(44, 102, 316, 214, { fill: 'var(--surface-2)' });
  box(40, 106, 316, 214, { fill: 'var(--surface)', stroke: 'var(--ctrl)', sw: 1.6 });
  tx(60, 124, 'Transformer encoder', { fs: 11.5, fw: 600, a: 'start' });
  tx(344, 124, '× 6', { fs: 11, fw: 700, fill: 'var(--ctrl)', a: 'end' });
  box(60, 132, 278, 40, { fill: 'var(--ctrl-soft)', stroke: 'var(--ctrl)' });
  tx(199, 150, 'Multi-Head Self-Attention', { fs: 11, fw: 600, fill: 'var(--ctrl)' });
  tx(199, 163, '8 heads · Q · K · V', { fs: 8.5, fill: 'var(--ink-3)', ff: 'var(--font-mono)' });
  arr(199, 172, 180);
  box(60, 180, 278, 22, { fill: 'var(--surface-2)' });
  tx(199, 195, 'Add & Norm', { fs: 10 });
  arr(199, 202, 210);
  box(60, 210, 278, 40, { fill: 'var(--surface-2)' });
  tx(199, 228, 'Feed-Forward', { fs: 11, fw: 600 });
  tx(199, 241, 'dropout', { fs: 8.5, fill: 'var(--ink-3)', ff: 'var(--font-mono)' });
  arr(199, 250, 258);
  box(60, 258, 278, 22, { fill: 'var(--surface-2)' });
  tx(199, 273, 'Add & Norm', { fs: 10 });
  // Residual skips.
  for (const [a, b] of [[132, 191], [210, 269]])
    out.push(el('path', { d: `M72,${a} C46,${a} 46,${b} 58,${b}`, fill: 'none', 'stroke-width': 1, 'stroke-dasharray': '3 3', 'marker-end': 'url(#txah)', opacity: 0.7 }, 'stroke:var(--ctrl)'));
  arr(199, 300, 330);

  // Head.
  box(86, 330, 228, 28, { fill: 'var(--surface-2)' });
  tx(200, 349, 'Global Average Pooling', { fs: 11 });
  arr(200, 358, 366);
  box(110, 366, 180, 26, { fill: 'var(--surface-2)' });
  tx(200, 383, 'Dropout · p = 0.5', { fs: 10.5 });
  arr(200, 392, 400);
  box(120, 400, 160, 28, { fill: 'var(--ctrl-soft)', stroke: 'var(--ctrl)' });
  tx(200, 418, 'Fully Connected', { fs: 11, fw: 600, fill: 'var(--ctrl)' });
  arr(200, 428, 438);
  for (const [name, col, x] of [['Control', 'var(--ctl)', 48], ['Prodromal', 'var(--prod)', 156], ['PD', 'var(--pd)', 264]] as const) {
    box(x, 440, 98, 28, { r: 14, fill: 'var(--surface)', stroke: col, sw: 1.6 });
    tx(x + 49, 458, name, { fs: 10.5, fw: 600, fill: col });
    out.push(el('line', { x1: 200, y1: 438, x2: x + 49, y2: 440, 'stroke-width': 1, opacity: 0.5 }, 'stroke:var(--ink-3)'));
  }

  // Self-attention inset.
  box(398, 106, 266, 196, { fill: 'var(--surface-2)' });
  tx(531, 126, 'Self-attention', { fs: 11, fw: 600 });
  tx(531, 142, 'softmax(QKᵀ / √dₖ) · V', { fs: 9.5, ff: 'var(--font-mono)', fill: 'var(--ink-2)' });
  const mX = 486, mY = 152, cs = 15;
  for (let r = 0; r < 6; r++)
    for (let c = 0; c < 6; c++) {
      const it = r === c ? 0.85 : 0.12 + rand() * 0.5;
      out.push(el('rect', { x: mX + c * cs, y: mY + r * cs, width: cs - 1, height: cs - 1, fill: `rgba(43,95,170,${it.toFixed(2)})` }));
    }
  tx(531, mY + 6 * cs + 16, 'attention weights · tokens × tokens', { fs: 8, fill: 'var(--ink-3)', ff: 'var(--font-mono)' });
  tx(531, mY + 6 * cs + 32, '× 8 heads, concatenated', { fs: 9.5, fill: 'var(--ctrl)', ff: 'var(--font-mono)' });
  out.push(el('line', { x1: 338, y1: 152, x2: 398, y2: 152, 'stroke-width': 1, 'stroke-dasharray': '3 3', opacity: 0.6 }, 'stroke:var(--ctrl)'));
  return out.join('');
}

// Stage 6: benchmark grouped bar chart (the paper's Table I), 560 × 270.
function benchSvg() {
  const out: string[] = [];
  const W = 560, H = 270, mL = 34, mR = 12, mT = 14, mB = 54, LO = 70, HI = 85;
  const pw = W - mL - mR, ph = H - mT - mB, base = mT + ph;
  const metrics = ['Precision', 'Recall', 'F1', 'Accuracy'];
  const models = [
    { k: 'ct', c: 'var(--accent)', v: [80.49, 79.89, 79.8, 80.51] },
    { k: 'vgg', c: 'var(--ctrl)', v: [82.8, 73.74, 73.81, 78.36] },
    { k: 'dn', c: 'var(--ink-3)', v: [82.48, 75.15, 75.51, 77.55] },
  ];
  const Y = (val: number) => mT + ph * (1 - (val - LO) / (HI - LO));
  for (const g of [70, 75, 80, 85]) {
    const y = Y(g);
    out.push(el('line', { x1: mL, y1: y, x2: W - mR, y2: y, 'stroke-width': 1 }, 'stroke:var(--border)'));
    out.push(el('text', { x: mL - 5, y: y + 3, 'text-anchor': 'end', 'font-size': 9 }, 'fill:var(--ink-3);font-family:var(--font-mono)', String(g)));
  }
  const gw = pw / metrics.length, barPad = 12, innerPad = 5, bw = (gw - barPad * 2 - innerPad * 2) / 3;
  metrics.forEach((m, gi) => {
    const gx = mL + gi * gw;
    out.push(el('text', { x: gx + gw / 2, y: H - mB + 18, 'text-anchor': 'middle', 'font-size': 11 }, 'fill:var(--ink-2);font-family:var(--font-body)', m));
    models.forEach((md, mi) => {
      const val = md.v[gi], x = gx + barPad + mi * (bw + innerPad), y = Y(val);
      out.push(el('rect', { x, y, width: bw, height: base - y, rx: 2, opacity: md.k === 'ct' ? 1 : 0.82 }, `fill:${md.c}`));
      out.push(el('text', { x: x + bw / 2, y: y - 3, 'text-anchor': 'middle', 'font-size': 8 }, 'fill:var(--ink-2);font-family:var(--font-mono)', val.toFixed(1)));
    });
  });
  return out.join('');
}
const encoder = encoderSvg();
const bench = benchSvg();

const scores = [
  { v: '80.5%', k: 'Accuracy' },
  { v: '80.5%', k: 'Precision' },
  { v: '79.9%', k: 'Recall' },
  { v: '0.80', k: 'F1' },
  { v: '0.84', k: 'AUC-ROC' },
];
---

<div class="explainer" data-mri={MRI} data-middle={MIDDLE}>
  <nav class="rail" aria-label="Stages">
    {stages.map((s) => (
      <a href={`#${s.id}`} data-rail={s.id}>
        <span class="pip" aria-hidden="true"></span>
        <span class="lbl">{s.rail}</span>
      </a>
    ))}
  </nav>

  <section class="stage" id="s1" aria-labelledby="s1-title">
    <div class="kick">Stage 1 · The data</div>
    <h2 id="s1-title">PPMI — three cohorts</h2>
    <p>Scans come from the <b>Parkinson's Progression Markers Initiative (PPMI)</b>: T1-weighted structural MRI from three groups the model learns to separate. Access needs a data-use agreement, so no raw scans are hosted here — the brain shown throughout is the open MNI152 template, for illustration.</p>
    <div class="viz">
      <div class="cohorts">
        {cohorts.map((c) => (
          <div class="cohort">
            <div class={`nm ${c.c}`}>{c.name}</div>
            <div class="ds">{c.desc}</div>
            <div class="stackmini" aria-hidden="true">
              {[5, 6, 7, 8].map((n) => <span style={`background-image:url('${slice(n)}')`}></span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="stage" id="s2" aria-labelledby="s2-title">
    <div class="kick">Stage 2 · One scan</div>
    <h2 id="s2-title">A 3D volume → the middle axial slice</h2>
    <p>Each scan is a 3D stack of slices. Rather than process the whole volume, the model takes the <b>middle axial slice</b> — one representative 2D image. Scrub the stack: the highlighted frame is the slice that goes forward.</p>
    <div class="viz">
      <div class="slice-row">
        <div class="volume" aria-hidden="true">
          {volume.map((v) => <span style={v.style}></span>)}
        </div>
        <div class="bigslice">
          <img data-ref="slice" src={slice(MIDDLE)} width="299" height="299" alt="Axial brain MRI slice (MNI152 template)" />
          <div class="scrub">
            <input
              type="range"
              data-ref="scrub"
              min="0"
              max="12"
              value={MIDDLE}
              aria-label="Slice through the volume"
              aria-valuetext={`slice ${MIDDLE + 1} of 13, middle slice (used)`}
            />
          </div>
          <div class="slicelbl">slice <span data-ref="sliceNum">{MIDDLE + 1}</span> / 13 &nbsp;<span class="midtag" data-ref="midtag">← middle slice (used)</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="stage" id="s3" aria-labelledby="s3-title">
    <div class="kick">Stage 3 · Preprocess</div>
    <h2 id="s3-title">Preparing the slice</h2>
    <p>Before the network sees it, the slice is standardised so every scan is comparable.</p>
    <div class="viz">
      <div class="pipe">
        {preprocess.map((p, i) => (
          <>
            {i > 0 && <span class="parrow" aria-hidden="true">→</span>}
            <div class={`pstep ${p.cls}`}>
              <div class="thumb">
                <img src={slice(MIDDLE)} width="92" height="92" alt="" loading="lazy" />
                {p.cls === 'm-reg' && <div class="cross"></div>}
              </div>
              <div class="cap">{p.cap}</div>
            </div>
          </>
        ))}
      </div>
      <p class="note center">Volumes are registered to the MNI PD25-T1MPRAGE (1 mm) template in MATLAB; the single-channel slice is duplicated across RGB for ResNet18. Training-only augmentation: rotation ±10°, horizontal flip, colour jitter, and affine shifts.</p>
    </div>
  </section>

  <section class="stage" id="s4" aria-labelledby="s4-title">
    <div class="kick">Stage 4 · CNN</div>
    <h2 id="s4-title">ResNet18 reads local structure</h2>
    <p>The 2D slice passes through <b>ResNet18</b>. Each block shrinks the image spatially and deepens it into more feature channels — capturing local structure: edges, tissue boundaries, shapes.</p>
    <div class="viz">
      <div class="cnn">
        {maps.map((m, i) => (
          <>
            {i > 0 && <span class="parrow" aria-hidden="true">→</span>}
            <div class="blk">
              <canvas class="fmapc" data-s={m.s} data-cells={m.cells} data-depth={m.depth} aria-hidden="true"></canvas>
              <div class="lab"><b>{m.l}</b>{m.d}</div>
            </div>
          </>
        ))}
      </div>
      <p class="note center spaced">ResNet18 (ImageNet-pretrained), with the fully-connected head removed, ending in a 512-channel feature map (7×7×512). The stacks show feature maps shrinking spatially and deepening in channels — hover a layer to watch its maps recompute.</p>
    </div>
  </section>

  <section class="stage" id="s5" aria-labelledby="s5-title">
    <div class="kick">Stage 5 · Transformer</div>
    <h2 id="s5-title">The Transformer relates distant regions</h2>
    <p>The feature map is flattened into a sequence of <b>tokens</b> (one per spatial position), given positional encodings, and passed to a <b>Transformer encoder (6 layers, 8 heads)</b>. Self-attention lets any region influence any other — long-range relationships a CNN alone can't capture.</p>
    <div class="viz">
      <svg
        class="tx"
        viewBox="0 0 680 510"
        role="img"
        aria-label="Transformer encoder: tokens with positional encoding into six encoder blocks, each with multi-head self-attention and feed-forward sublayers with residual add and norm, then global average pooling, dropout and a fully-connected three-class head; a side panel shows the self-attention weight matrix across tokens for eight heads"
        set:html={encoder}
      />
      <p class="note center tx-note">The 7×7×512 feature map is flattened to 49 tokens (d = 512) with positional encodings, then passed through <b>6 encoder blocks</b> — each: multi-head self-attention (8 heads) → Add &amp; Norm → feed-forward (dropout) → Add &amp; Norm. Global average pooling (no CLS token) → dropout p = 0.5 → fully-connected head → the three classes.</p>
    </div>
  </section>

  <section class="stage" id="s6" aria-labelledby="s6-title">
    <div class="kick">Stage 6 · Prediction &amp; attention</div>
    <h2 id="s6-title">The verdict — and where it looked</h2>
    <p>A classification head turns the Transformer's output into three probabilities. Pick an example cohort to see a typical prediction, and toggle the <b>attention map</b> to see which regions of the slice drove it.</p>
    <div class="viz">
      <div class="out-row">
        <div class="slicebox">
          <img src={`${MRI}/slice_mid.png`} width="240" height="240" alt="Axial brain MRI slice (MNI152 template)" loading="lazy" />
        </div>
        <div class="outpanel">
          <div class="switch" role="group" aria-label="Example cohort">
            <button type="button" class="ctl on" data-c="ctl" aria-pressed="true">Control</button>
            <button type="button" class="prod" data-c="prod" aria-pressed="false">Prodromal</button>
            <button type="button" class="pd" data-c="pd" aria-pressed="false">PD</button>
          </div>
          <div class="probs">
            {[['ctl', 'Control', 82], ['prod', 'Prodromal', 12], ['pd', 'PD', 6]].map(([c, nm, p]) => (
              <div class={`prob ${c}`}>
                <span class="nm">{nm}</span>
                <span class="track"><span class="fill" data-fill={c} style={`width:${p}%`}></span></span>
                <span class="pct" data-pct={c}>{p}%</span>
              </div>
            ))}
          </div>
          <p class="verdict" aria-live="polite">Predicted: <b data-ref="verdict">Control</b></p>
        </div>
      </div>
      <div class="scores">
        {scores.map((s) => (
          <div class="score"><div class="v">{s.v}</div><div class="k">{s.k}</div></div>
        ))}
      </div>
      <div class="bench">
        <div class="bench-title">Benchmark — hybrid vs 3D CNN baselines (PPMI test set, %)</div>
        <svg
          viewBox="0 0 560 270"
          role="img"
          aria-label="Grouped bar chart comparing precision, recall, F1 and accuracy for the hybrid CNN-Transformer against 3D VGG16 and 3D DenseNet121"
          set:html={bench}
        />
        <div class="bench-legend">
          <span><i style="background:var(--accent)"></i>CNN-Transformer (ours)</span>
          <span><i style="background:var(--ctrl)"></i>3D VGG16</span>
          <span><i style="background:var(--ink-3)"></i>3D DenseNet121</span>
        </div>
        <p class="note bench-note">Slightly lower precision, but clearly higher recall and F1 — the balance that matters most in a clinical screen. Axis 70–85%.</p>
      </div>
      <p class="note next-step"><b>Next step:</b> region-level interpretability — showing which brain area drives each prediction. The published model reports classification only and notes this as future work.</p>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.explainer');
  if (root) {
    const $ = <T extends Element = HTMLElement>(ref: string) => root.querySelector<T>(`[data-ref="${ref}"]`);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const stages = [...root.querySelectorAll<HTMLElement>('.stage')];
    const railLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-rail]')];
    const navH = document.getElementById('site-nav')?.offsetHeight ?? 0;
    const mri = root.dataset.mri!;
    const middle = Number(root.dataset.middle);
    const slice = (i: number) => `${mri}/slice_${String(i).padStart(2, '0')}.png`;

    // Reveal each stage as it scrolls in (once). With reduced motion every
    // stage is simply shown; the CSS only hides them for motion-OK visitors
    // once this script has run.
    root.classList.add('js');
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          reveal.unobserve(e.target);
          // Load the rest of the stack once the scrubber is near.
          if (e.target.id === 's2') for (let i = 0; i <= 12; i++) new Image().src = slice(i);
        }
      },
      // Same idea as the hero: the sticky nav hides the top of the window.
      { rootMargin: `-${navH}px 0px -8% 0px`, threshold: 0.12 },
    );
    stages.forEach((s) => reveal.observe(s));

    // Progress rail: the stage crossing the middle of the window is current.
    const setCurrent = (id: string) => {
      for (const a of railLinks) {
        const on = a.dataset.rail === id;
        a.classList.toggle('on', on);
        if (on) a.setAttribute('aria-current', 'step');
        else a.removeAttribute('aria-current');
      }
    };
    const current = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setCurrent(e.target.id);
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    stages.forEach((s) => current.observe(s));
    for (const a of railLinks) {
      a.addEventListener('click', (e) => {
        const target = document.getElementById(a.dataset.rail!);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduced.matches ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', `#${target.id}`);
      });
    }

    // Stage 2: slice scrubber.
    const scrub = $<HTMLInputElement>('scrub'), img = $<HTMLImageElement>('slice');
    const num = $('sliceNum'), midtag = $('midtag');
    scrub?.addEventListener('input', () => {
      const v = Number(scrub.value);
      if (img) img.src = slice(v);
      if (num) num.textContent = String(v + 1);
      if (midtag) midtag.hidden = v !== middle;
      scrub.setAttribute('aria-valuetext', `slice ${v + 1} of 13${v === middle ? ', middle slice (used)' : ''}`);
    });

    // Stage 4: each ResNet18 stage as a stack of feature maps — a grid of
    // activations on the front face, slices behind it for channels.
    // Hovering a stage recomputes its maps for a few frames.
    const STEP = 4;
    const dpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
    const randAct = (n: number) => Array.from({ length: n * n }, Math.random);
    function rr(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      ctx.beginPath(); ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
    }
    function drawStack(cv: HTMLCanvasElement, act: number[]) {
      const ctx = cv.getContext('2d');
      if (!ctx) return;
      const s = Number(cv.dataset.s), cells = Number(cv.dataset.cells), depth = Number(cv.dataset.depth);
      const off = depth * STEP, W = s + off, H = s + off;
      cv.width = W * dpr; cv.height = H * dpr;
      cv.style.width = `${W}px`; cv.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      for (let d = depth - 1; d >= 1; d--) {
        // Back slices = channels.
        ctx.fillStyle = `rgba(59,111,176,${0.1 + 0.04 * d})`;
        ctx.strokeStyle = 'rgba(59,111,176,0.35)'; ctx.lineWidth = 1;
        rr(ctx, d * STEP, (depth - d) * STEP, s, s, 4); ctx.fill(); ctx.stroke();
      }
      // Front face = feature map.
      const fy = off, cs = s / cells;
      for (let r = 0; r < cells; r++)
        for (let c = 0; c < cells; c++) {
          ctx.fillStyle = `rgba(43,95,170,${0.15 + act[r * cells + c] * 0.75})`;
          ctx.fillRect(c * cs + 0.5, fy + r * cs + 0.5, cs - 1, cs - 1);
        }
      ctx.strokeStyle = 'rgba(59,111,176,0.55)'; ctx.lineWidth = 1;
      rr(ctx, 0, fy, s, s, 4); ctx.stroke();
    }
    for (const cv of root.querySelectorAll<HTMLCanvasElement>('.fmapc')) {
      const cells = Number(cv.dataset.cells);
      drawStack(cv, randAct(cells));
      cv.closest('.blk')?.addEventListener('mouseenter', () => {
        if (reduced.matches) return;
        let f = 0;
        const iv = setInterval(() => {
          drawStack(cv, randAct(cells));
          if (++f >= 5) clearInterval(iv);
        }, 90);
      });
    }

    // Stage 6: example predictions per cohort. Illustrative outputs, not
    // from specific scans (spec §6).
    const EX: Record<string, { p: [number, number, number]; v: string }> = {
      ctl: { p: [82, 12, 6], v: 'Control' },
      prod: { p: [20, 60, 20], v: 'Prodromal' },
      pd: { p: [8, 22, 70], v: 'PD' },
    };
    const cohortBtns = [...root.querySelectorAll<HTMLButtonElement>('.switch button')];
    function setCohort(c: string) {
      const e = EX[c];
      (['ctl', 'prod', 'pd'] as const).forEach((k, i) => {
        const fill = root!.querySelector<HTMLElement>(`[data-fill="${k}"]`);
        const pct = root!.querySelector<HTMLElement>(`[data-pct="${k}"]`);
        if (fill) fill.style.width = `${e.p[i]}%`;
        if (pct) pct.textContent = `${e.p[i]}%`;
      });
      const verdict = $('verdict');
      if (verdict) verdict.textContent = e.v;
      for (const b of cohortBtns) {
        b.classList.toggle('on', b.dataset.c === c);
        b.setAttribute('aria-pressed', String(b.dataset.c === c));
      }
    }
    cohortBtns.forEach((b) => b.addEventListener('click', () => setCohort(b.dataset.c!)));

    setCohort('ctl');
  }
</script>

