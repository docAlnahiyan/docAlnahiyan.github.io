---
// Interactive warehouse simulation (design-reference/research-page-spec.md §4),
// ported from pub-page-demo.html. Runs on the client only; logic lives in
// warehouse-sim.ts. It keeps its own flat light look in both themes, framed
// as a figure by the page.
// TODO (optional, spec §7): a dark palette for .sim driven by data-theme.
---

<div class="sim" data-sim>
  <div class="simhead">
    <span class="k">Live warehouse simulation</span>
    <span class="clock" data-ref="clock">Day 1 · 08:00</span>
  </div>
  <div class="steps">
    <span class="step"><b>1</b> Honest operations</span><span class="arrow" aria-hidden="true">→</span>
    <span class="step"><b>2</b> Theft hides in the record · truth sealed</span><span class="arrow" aria-hidden="true">→</span>
    <span class="step"><b>3</b> Counts open loss windows</span><span class="arrow" aria-hidden="true">→</span>
    <span class="step"><b>4</b> Channels rank who to review</span>
  </div>
  <div class="mainrow">
    <div class="floor-wrap">
      <canvas
        data-ref="canvas"
        width="1020"
        height="440"
        role="img"
        aria-label="Top-down warehouse floor: six coloured zones with shelves and cameras, and 16 workers moving between them."
      ></canvas>
      <div class="banner" data-ref="banner" role="status" aria-live="polite"></div>
    </div>
    <aside class="attr" aria-label="Who to review">
      <h4>Who to review</h4>
      <p class="sub">Each employee ranked against their <em>own</em> baseline. No one is accused — this is a shortlist.</p>
      <div class="chan chanA">
        <div class="ch-head"><span class="ch-name">A · Presence lift</span><span class="ch-tag">physical</span></div>
        <div class="ch-desc">In loss windows more than their routine predicts? &gt;1× = over-exposed.</div>
        <div data-ref="rankA"></div>
      </div>
      <div class="chan chanB">
        <div class="ch-head"><span class="ch-name">B · Write-off anomaly</span><span class="ch-tag">record edit</span></div>
        <div class="ch-desc">Writes off far more value than peers? Scored vs the peer median.</div>
        <div data-ref="rankB"></div>
      </div>
      <div class="reveal-note" data-ref="revealNote"></div>
    </aside>
  </div>
  <div class="bar-ctrl">
    <div class="stats">
      <div class="stat"><span class="k">Actions</span><span class="v" data-ref="actions">0</span></div>
      <div class="stat"><span class="k">In stock</span><span class="v" data-ref="stock">0</span></div>
      <div class="stat"><span class="k">Loss windows</span><span class="v red" data-ref="loss">0</span></div>
    </div>
    <div class="spacer"></div>
    <button type="button" class="simbtn primary" data-ref="play" aria-pressed="false">❚❚ Pause</button>
    <button type="button" class="simbtn danger" data-ref="theft">Inject physical theft</button>
    <button type="button" class="simbtn danger" data-ref="edit">Inject record edit</button>
    <button type="button" class="simbtn gold" data-ref="reveal">Reveal sealed file</button>
    <div class="speed" role="group" aria-label="Speed">
      <button type="button" class="simbtn on" data-sp="1" aria-pressed="true">1×</button>
      <button type="button" class="simbtn" data-sp="2" aria-pressed="false">2×</button>
      <button type="button" class="simbtn" data-sp="4" aria-pressed="false">4×</button>
    </div>
    <div class="toggles">
      <label><input type="checkbox" data-ref="cams" checked /> Cameras</label>
      <label><input type="checkbox" data-ref="paths" /> Paths</label>
    </div>
  </div>
  <details class="logbox">
    <summary>Show transaction log</summary>
    <div class="log-wrap">
      <div class="log-head"><span>Time</span><span>Worker</span><span>Action</span><span class="r">Zone</span><span class="r">Qty</span><span>Note</span></div>
      <div class="log" data-ref="log"></div>
    </div>
  </details>
  <div class="legend">
    <div class="lg"><span class="dot" style="background:#2E6FE0"></span>Picker</div>
    <div class="lg"><span class="dot" style="background:#16A34A"></span>Approver (edits records)</div>
    <div class="lg"><span class="dot" style="background:#E0902A"></span>Counter</div>
    <div class="lg"><span class="dot" style="background:#C0392B"></span>Dishonest act</div>
    <div class="lg note">Injected theft goes to a sealed file, never the log.</div>
  </div>
</div>

<script>
  import { startSim } from './warehouse-sim';

  for (const root of document.querySelectorAll<HTMLElement>('[data-sim]')) {
    const sim = startSim(root);
    if (!sim) continue;

    // Reduced motion: start paused; the visitor can still press Play.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) sim.pause();

    // Same pattern as the hero: the loop runs only while the figure is on
    // screen (not behind the sticky nav, not in a hidden tab panel) and the
    // tab is visible.
    let inView = false;
    const apply = () => sim.setActive(inView && !document.hidden);
    document.addEventListener('visibilitychange', apply);
    const navH = document.getElementById('site-nav')?.offsetHeight ?? 0;
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        apply();
      },
      { rootMargin: `-${navH}px 0px 0px 0px` },
    ).observe(root);
  }
</script>

<style is:global>
  /* Everything is scoped under .sim, so its own flat light palette and
     system font stay inside the figure and the site's styles stay out. */
  .sim {
    --ink: #1F2A37; --muted: #64748B; --line: #E2E8F0; --panel: #F8FAFC;
    --navy: #1F3A5F; --navy-soft: #E8EEF5; --red: #C0392B; --red-soft: #FBEAE8;
    --green: #1E7A54; --amber: #B7791F;
    --floor: #F1F4F8; --shelf-dark: #94A3B8;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: #fff;
    line-height: 1.5;
    color-scheme: light;
    /* Layout follows the figure's own width (it sits in a column), not the window. */
    container-type: inline-size;
  }
  .sim .simhead { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 16px; border-bottom: 1px solid var(--line); }
  .sim .simhead .k { font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; color: var(--navy); font-weight: 700; text-transform: uppercase; }
  .sim .clock { font-variant-numeric: tabular-nums; font-size: 12.5px; color: var(--muted); font-weight: 600; }
  .sim .steps { display: flex; gap: 7px; padding: 8px 16px; border-bottom: 1px solid var(--line); background: var(--panel); flex-wrap: wrap; }
  .sim .step { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); }
  .sim .step b { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 9.5px; font-weight: 700; }
  .sim .steps .arrow { color: var(--shelf-dark); font-size: 11px; }
  .sim .mainrow { display: flex; align-items: stretch; }
  .sim .floor-wrap { flex: 1 1 auto; position: relative; background: var(--panel); display: flex; align-items: center; justify-content: center; padding: 12px 14px; min-width: 0; }
  .sim canvas { display: block; background: var(--floor); border-radius: 10px; box-shadow: 0 1px 0 var(--line); max-width: 100%; height: auto; }
  .sim .banner { position: absolute; top: 18px; left: 50%; transform: translateX(-50%); background: var(--red); color: #fff; font-size: 12px; font-weight: 600;
    padding: 7px 14px; border-radius: 20px; box-shadow: 0 6px 18px rgba(192,57,43,.28); opacity: 0; pointer-events: none; transition: opacity .3s;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; z-index: 5; max-width: 92%; }
  .sim .banner.show { opacity: 1; }
  .sim .attr { flex: 0 0 300px; border-left: 1px solid var(--line); padding: 13px 14px; display: flex; flex-direction: column; gap: 11px; background: #fff; }
  .sim .attr h4 { font-family: inherit; font-size: 11.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--navy); font-weight: 700; margin: 0; }
  .sim .attr .sub { font-size: 11px; color: var(--muted); line-height: 1.5; margin: 0; }
  .sim .chan { border: 1px solid var(--line); border-radius: 10px; padding: 9px 10px; }
  .sim .chan .ch-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 2px; }
  .sim .chan .ch-name { font-size: 12px; font-weight: 700; }
  .sim .chan .ch-tag { font-size: 9.5px; color: var(--muted); font-weight: 600; }
  .sim .chan .ch-desc { font-size: 10.5px; color: var(--muted); line-height: 1.4; margin-bottom: 8px; }
  .sim .rank { display: flex; align-items: center; gap: 7px; margin-top: 5px; font-size: 11.5px; }
  .sim .rank .pos { width: 14px; color: var(--muted); font-variant-numeric: tabular-nums; font-weight: 700; text-align: right; }
  .sim .rank .who { width: 44px; font-weight: 700; font-family: "SF Mono", ui-monospace, Menlo, monospace; color: var(--ink); white-space: nowrap; }
  .sim .rank .barwrap { flex: 1 1 auto; height: 8px; background: var(--panel); border-radius: 5px; overflow: hidden; }
  .sim .rank .bar { display: block; height: 100%; border-radius: 5px; transition: width .4s; }
  .sim .rank .scoreval { width: 38px; text-align: right; font-variant-numeric: tabular-nums; font-size: 10.5px; color: var(--muted); }
  .sim .rank.truth .who { color: var(--red); }
  .sim .rank.truth .who::after { content: " ✓"; color: var(--red); font-weight: 700; }
  .sim .chanA .bar { background: var(--navy); }
  .sim .chanB .bar { background: var(--amber); }
  .sim .chanA .rank.truth .bar, .sim .chanB .rank.truth .bar { background: var(--red); }
  .sim .reveal-note { font-size: 11px; color: var(--red); background: var(--red-soft); border: 1px solid #E7B7B0; border-radius: 8px; padding: 8px 10px; line-height: 1.5; display: none; }
  .sim .reveal-note.show { display: block; }
  .sim .bar-ctrl { display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .sim .stats { display: flex; gap: 18px; }
  .sim .stat { display: flex; flex-direction: column; gap: 1px; }
  .sim .stat .k { font-size: 9px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .sim .stat .v { font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .sim .stat .v.red { color: var(--red); }
  .sim .spacer { flex: 1 1 auto; }
  .sim button.simbtn { font: inherit; font-size: 12px; font-weight: 600; border: 1px solid var(--line); background: #fff; color: var(--ink); padding: 7px 11px; border-radius: 8px; cursor: pointer; transition: .12s; }
  .sim button.simbtn:hover { border-color: var(--shelf-dark); }
  .sim button.simbtn:focus-visible, .sim input:focus-visible, .sim summary:focus-visible { outline: 2px solid var(--navy); outline-offset: 2px; }
  .sim button.simbtn.primary { background: var(--navy); color: #fff; border-color: var(--navy); }
  .sim button.simbtn.danger { color: var(--red); border-color: #E7B7B0; }
  .sim button.simbtn.gold { color: var(--amber); border-color: #E6CF9B; }
  .sim .speed { display: flex; gap: 4px; }
  .sim .speed button { padding: 6px 9px; }
  .sim .speed button.on { background: var(--navy); color: #fff; border-color: var(--navy); }
  .sim .toggles { display: flex; gap: 12px; }
  .sim .toggles label { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 5px; cursor: pointer; }
  .sim details.logbox { border-top: 1px solid var(--line); }
  .sim details.logbox summary { padding: 10px 16px; font-size: 12px; color: var(--navy); font-weight: 600; cursor: pointer; list-style: none; }
  .sim details.logbox summary::-webkit-details-marker { display: none; }
  .sim details.logbox summary::before { content: "▸ "; color: var(--muted); }
  .sim details.logbox[open] summary::before { content: "▾ "; }
  /* The log keeps its six columns and scrolls sideways on narrow screens. */
  .sim .log-wrap { overflow-x: auto; }
  .sim .log-head, .sim .row { display: grid; grid-template-columns: 56px 66px minmax(140px, 1fr) 80px 54px minmax(120px, 1.2fr); gap: 14px; min-width: 620px; }
  .sim .log-head { padding: 8px 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    font-size: 9.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .sim .log-head .r { text-align: right; }
  .sim .log { height: 190px; overflow-y: auto; padding: 2px 12px 12px; min-width: 644px; }
  .sim .row { align-items: center; padding: 8px 9px; margin-top: 5px; border-radius: 8px; font-size: 12px; min-width: 0;
    background: #fff; border: 1px solid var(--line); font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace; animation: simpop .3s ease; }
  @keyframes simpop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .sim .row .t { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; }
  .sim .row .emp { font-weight: 700; color: var(--navy); }
  .sim .row .act { color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sim .row .zone { color: var(--muted); font-size: 10.5px; text-align: right; }
  .sim .row .qty { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .sim .row .qty.neg { color: var(--red); }
  .sim .row .qty.pos { color: var(--green); }
  .sim .row .note { color: var(--muted); font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sim .row.flag { background: var(--red-soft); border-color: #E7B7B0; }
  .sim .row.flag .act { color: var(--red); font-weight: 700; }
  .sim .row.count { background: var(--navy-soft); border-color: #C6D5E6; }
  .sim .row.count .act, .sim .row.count .emp { color: var(--navy); }
  .sim .legend { display: flex; flex-wrap: wrap; gap: 8px 14px; padding: 9px 16px; border-top: 1px solid var(--line); background: var(--panel); }
  .sim .lg { display: flex; align-items: center; gap: 6px; font-size: 10.5px; color: var(--muted); }
  .sim .lg.note { margin-left: auto; font-style: italic; }
  .sim .dot { width: 9px; height: 9px; border-radius: 50%; }
  /* The canvas needs the width more than the panel does: below 900px of
     figure the attribution panel moves under the floor, channels side by
     side, then stacked on phones. */
  @container (max-width: 900px) {
    .sim .mainrow { flex-direction: column; }
    .sim .attr { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; flex: 1 1 auto; border-left: none; border-top: 1px solid var(--line); }
    .sim .attr h4, .sim .attr .sub, .sim .reveal-note { grid-column: 1 / -1; }
    .sim .floor-wrap { padding: 10px; }
  }
  @container (max-width: 560px) {
    .sim .attr { grid-template-columns: 1fr; }
    .sim .floor-wrap { padding: 6px; }
    .sim .simhead, .sim .steps, .sim .bar-ctrl, .sim .legend { padding-inline: 12px; }
    .sim .lg.note { margin-left: 0; }
  }
</style>
