---
import { getProfile } from '../lib/content';

const profile = await getProfile();
const { links } = profile;
const year = new Date().getFullYear();

// Only links that have been filled in are shown. The Upwork page itself is
// linked from here rather than the header nav.
const external = [
  { label: 'Google Scholar', href: links.scholar },
  { label: 'ORCID', href: links.orcid },
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'Upwork profile', href: links.upwork },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---

<footer class="footer">
  <div class="footer-inner">
    <p class="footer-contact">
      <span class="footer-label">Email</span>
      <span class="selectable">{links.email}</span>
    </p>
    <ul class="footer-links">
      <li><a href="/upwork/">Upwork</a></li>
      {external.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
    </ul>
    <p class="footer-copy">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 28px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .footer-inner {
    max-width: var(--maxw-wide);
    margin: 0 auto;
    padding-inline: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-items: baseline;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-label {
    margin-right: 8px;
  }
  .selectable {
    color: var(--ink);
    user-select: all;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    color: var(--ink-2);
  }
  .footer-links a:hover {
    color: var(--accent-ink);
  }
  .footer-copy {
    margin-left: auto !important;
  }
  @media (max-width: 560px) {
    .footer-copy {
      margin-left: 0 !important;
      width: 100%;
    }
  }
</style>
