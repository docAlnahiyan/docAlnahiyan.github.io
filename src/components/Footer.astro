---
import { SITE } from '../site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <span>© {year} {SITE.name}</span>
    <slot />
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 24px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: baseline;
  }
</style>
