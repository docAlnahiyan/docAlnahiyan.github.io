---
import { NAV, SITE } from '../site';

// A nav item is active on its own page and on any page beneath it
// (e.g. /research/hybridtransmedformer/ highlights Research).
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<nav class="nav" aria-label="Main">
  <div class="nav-inner">
    <a class="brand" href="/">{SITE.shortName}<span>.</span></a>
    <ul class="nav-links">
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <button class="theme-btn" id="theme-toggle" type="button" aria-label="Switch to dark theme">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    </button>
  </div>
</nav>

<script>
  // The inline script in BaseLayout applies the saved theme before first
  // paint; this only handles clicks and keeps the button label accurate.
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const effective = () =>
    root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  const syncLabel = () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    btn?.setAttribute('aria-label', `Switch to ${next} theme`);
  };

  btn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncLabel();
  });

  media.addEventListener('change', syncLabel);
  syncLabel();
</script>

<style>
  .nav {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding-block: 12px;
    padding-inline: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -.01em;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  .nav-links {
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav-links a {
    display: block;
    font-size: 13.5px;
    color: var(--ink-2);
    padding: 6px 10px;
    border-radius: 7px;
  }
  .nav-links a:hover {
    color: var(--ink);
    background: var(--surface-2);
    text-decoration: none;
  }
  .nav-links a[aria-current='page'] {
    color: var(--accent-ink);
    background: var(--accent-wash);
  }
  .theme-btn {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme-btn:hover {
    color: var(--ink);
    border-color: var(--border-strong);
  }

  /* Show the icon for the theme the button switches TO. */
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .nav-inner {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .nav-links {
      order: 3;
      width: 100%;
      margin-left: -10px;
    }
    .theme-btn {
      margin-left: auto;
    }
  }
</style>
