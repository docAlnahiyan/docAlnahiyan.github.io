---
import { NAV, SITE } from '../site';

// A nav item is active on its own page and on any page beneath it
// (e.g. /research/hybridtransmedformer/ highlights Research).
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<nav class="nav" id="site-nav" aria-label="Main">
  <div class="nav-inner">
    <a class="brand" href="/">{SITE.shortName}<span>.</span></a>
    <button class="menu-btn" id="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
      <svg class="icon-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <ul class="nav-links" id="nav-menu">
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <button class="theme-btn search-btn" id="search-open" type="button" aria-label="Search the site" aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <button class="theme-btn" id="theme-toggle" type="button" aria-label="Switch to dark theme">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    </button>
  </div>
  <dialog class="search-dialog" id="search-dialog" aria-label="Search the site">
    <div class="search-bar">
      <svg class="search-glass" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="search-input" class="search-input" type="search" placeholder="Search research, projects and posts" autocomplete="off" spellcheck="false" aria-label="Search" aria-controls="search-results" aria-autocomplete="list" />
      <button type="button" class="search-close" aria-label="Close search"><kbd>Esc</kbd></button>
    </div>
    <div class="search-body">
      <p class="search-status" id="search-status" aria-live="polite"></p>
      <ul class="search-results" id="search-results" role="listbox" aria-label="Results"></ul>
      <div class="search-empty" id="search-empty">
        <p class="search-hint-title">Jump to</p>
        <div class="search-quick">
          <a href="/research/">Research</a><a href="/publications/">Publications</a><a href="/projects/">Projects</a><a href="/blog/">Blog</a><a href="/cv/">CV</a>
        </div>
        <p class="search-hint-title">Try</p>
        <div class="search-quick search-try">
          <button type="button">Parkinson's</button><button type="button">MRI</button><button type="button">emotion recognition</button><button type="button">transformer</button>
        </div>
      </div>
      <p class="search-fallback" hidden>Search isn't available right now. Try the <a href="/research/">Research</a>, <a href="/projects/">Projects</a> or <a href="/blog/">Blog</a> pages.</p>
    </div>
    <div class="search-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>Esc</kbd> close</span>
    </div>
  </dialog>
</nav>

<script>
  // The inline script in BaseLayout applies the saved theme before first
  // paint; this only handles clicks and keeps the button label accurate.
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const effective = () =>
    root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  const syncLabel = () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    btn?.setAttribute('aria-label', `Switch to ${next} theme`);
  };

  // Ease the page chrome and the sky between palettes (.theme-anim in
  // global.css and HeroScene.astro); skipped with reduced motion.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let easing = 0;
  const easeSwitch = () => {
    if (reduced.matches) return;
    root.classList.add('theme-anim');
    clearTimeout(easing);
    easing = window.setTimeout(() => root.classList.remove('theme-anim'), 250);
  };

  btn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    easeSwitch();
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncLabel();
  });

  media.addEventListener('change', () => {
    if (!root.dataset.theme) easeSwitch();
    syncLabel();
  });
  syncLabel();

  // Site search (Pagefind, built into /pagefind/ after the site is built).
  // The UI loads the first time the dialog opens. "/" or Ctrl/Cmd+K opens it;
  // Esc closes it (the dialog's own behaviour) and focus returns.
  const searchBtn = document.getElementById('search-open');
  const searchDialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  if (searchBtn && searchDialog) {
    searchBtn.hidden = false;
    // Pagefind's search API (built into /pagefind/ after the site is built),
    // loaded the first time the dialog opens; results are drawn here so they
    // match the site rather than Pagefind's stock widget.
    type Sub = { title: string; url: string; excerpt: string };
    type Hit = { url: string; excerpt: string; meta: { title?: string }; sub_results?: Sub[] };
    type Pagefind = { init: () => Promise<void>; debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: { data: () => Promise<Hit> }[] } | null> };
    const input = searchDialog.querySelector<HTMLInputElement>('#search-input')!;
    const list = searchDialog.querySelector<HTMLUListElement>('#search-results')!;
    const status = searchDialog.querySelector<HTMLElement>('#search-status')!;
    const empty = searchDialog.querySelector<HTMLElement>('#search-empty')!;
    const SECTIONS: [RegExp, string][] = [[/^\/research\//, 'Research'], [/^\/projects\//, 'Project'], [/^\/blog\//, 'Blog'], [/^\/publications\//, 'Publications'], [/^\/cv\//, 'CV'], [/^\/upwork\//, 'Upwork']];
    const section = (url: string) => SECTIONS.find(([re]) => re.test(url))?.[1] ?? 'Page';
    const clean = (url: string) => url.replace(/\.html$/, '/').replace(/\/index\/$/, '/');
    let loaded: Promise<Pagefind> | undefined;
    const loadPagefind = () =>
      (loaded ??= (async () => {
        const url = '/pagefind/pagefind.js';
        const pf = (await import(/* @vite-ignore */ url)) as Pagefind;
        await pf.init();
        return pf;
      })());
    let active = -1;
    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a.sr-main, a.sr-sub')];
    const setActive = (i: number) => {
      const all = items();
      if (!all.length) return;
      active = (i + all.length) % all.length;
      all.forEach((a, k) => a.classList.toggle('is-active', k === active));
      all[active].scrollIntoView({ block: 'nearest' });
    };
    let seq = 0;
    const run = async () => {
      const q = input.value.trim();
      const mine = ++seq;
      if (!q) {
        list.replaceChildren();
        status.textContent = '';
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      const pf = await loadPagefind();
      const res = await pf.debouncedSearch(q, {}, 120);
      if (!res || mine !== seq) return;
      const hits = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
      if (mine !== seq) return;
      status.textContent = res.results.length
        ? `${res.results.length} result${res.results.length === 1 ? '' : 's'}`
        : `No results for "${q}"`;
      list.innerHTML = hits
        .map((h) => {
          const subs = (h.sub_results ?? []).filter((s) => clean(s.url) !== clean(h.url)).slice(0, 2);
          return `<li role="option"><a class="sr-main" href="${clean(h.url)}"><span class="sr-kind">${section(clean(h.url))}</span><span class="sr-title">${h.meta.title ?? clean(h.url)}</span><span class="sr-excerpt">${h.excerpt}</span></a>${
            subs.length ? `<div class="sr-subs">${subs.map((s) => `<a class="sr-sub" href="${s.url}"><span class="sr-sub-title">${s.title}</span><span class="sr-excerpt">${s.excerpt}</span></a>`).join('')}</div>` : ''
          }</li>`;
        })
        .join('');
      active = -1;
      setActive(0);
    };
    input.addEventListener('input', run);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') { const a = items()[active]; if (a) { e.preventDefault(); a.click(); } }
      else if (e.key === 'Escape') { e.preventDefault(); searchDialog.close(); }
    });
    searchDialog.querySelectorAll<HTMLButtonElement>('.search-try button').forEach((b) =>
      b.addEventListener('click', () => { input.value = b.textContent ?? ''; input.focus(); run(); }),
    );
    const open = async () => {
      if (!searchDialog.open) searchDialog.showModal();
      input.focus();
      input.select();
      try {
        await loadPagefind();
      } catch {
        searchDialog.querySelector<HTMLElement>('.search-fallback')!.hidden = false;
        empty.hidden = true;
      }
    };
    searchBtn.addEventListener('click', open);
    searchDialog.querySelector('.search-close')?.addEventListener('click', () => searchDialog.close());
    searchDialog.addEventListener('click', (e) => {
      if (e.target === searchDialog) searchDialog.close();
    });
    searchDialog.addEventListener('close', () => searchBtn.focus());
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
      if ((e.key === '/' && !typing) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        open();
      }
    });
  }

  // Menu button for narrow screens. The class is only added when this script
  // runs, so without JavaScript the links simply wrap and stay visible.
  const nav = document.getElementById('site-nav');
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('nav-menu');
  if (nav && menuBtn && menu) {
    nav.classList.add('has-menu');
    const setOpen = (open: boolean) => {
      nav.toggleAttribute('data-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    };
    menuBtn.addEventListener('click', () => setOpen(!nav.hasAttribute('data-open')));
    // Close after choosing a link (needed for /#about on the home page),
    // on Escape, on a click elsewhere, and when the screen widens.
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
        setOpen(false);
        menuBtn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (nav.hasAttribute('data-open') && !nav.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border);
    /* Its own compositor layer, so scrolling content under the translucent
       bar never forces it (or the page) to be repainted each frame. The
       dropdown menu is absolutely positioned, so the transform is safe. */
    will-change: transform;
    transform: translateZ(0);
  }
  .nav-inner {
    max-width: var(--maxw-wide);
    margin: 0 auto;
    padding-block: 12px;
    padding-inline: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -.01em;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  .nav-links {
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav-links a {
    display: block;
    font-size: 13.5px;
    color: var(--ink-2);
    padding: 6px 10px;
    border-radius: calc(7px * var(--round, 1));
  }
  .nav-links a:hover {
    color: var(--ink);
    background: var(--surface-2);
    text-decoration: none;
  }
  .nav-links a[aria-current='page'] {
    color: var(--accent-ink);
    background: var(--accent-wash);
  }
  .theme-btn {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: calc(8px * var(--round, 1));
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme-btn:hover {
    color: var(--ink);
    border-color: var(--border-strong);
  }
  .search-btn[hidden] {
    display: none;
  }

  /* Search dialog: a site-styled palette over Pagefind's search API. */
  .search-dialog {
    width: min(640px, calc(100vw - 32px));
    max-height: min(76vh, 680px);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: calc(16px * var(--round, 1));
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / .35), 0 2px 6px rgb(0 0 0 / .08);
    overflow: hidden;
  }
  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .search-dialog::backdrop {
    background: rgb(10 10 10 / .38);
    backdrop-filter: blur(3px);
  }
  .search-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .search-glass {
    flex: none;
    color: var(--accent);
  }
  .search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 17px;
    padding: 6px 0;
  }
  .search-input::placeholder {
    color: var(--ink-3);
  }
  .search-input::-webkit-search-cancel-button {
    display: none;
  }
  .search-close {
    flex: none;
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
  }
  .search-dialog kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: calc(5px * var(--round, 1));
    padding: 2px 6px;
  }
  .search-body {
    overflow-y: auto;
    padding: 8px 10px 12px;
    flex: 1;
  }
  .search-status {
    margin: 6px 10px 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .search-status:empty {
    display: none;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .search-results :global(a) {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: calc(10px * var(--round, 1));
    border: 1px solid transparent;
  }
  .search-results :global(a.sr-main) {
    padding: 10px 12px;
  }
  .search-results :global(a:hover),
  .search-results :global(a.is-active) {
    background: var(--surface);
    border-color: var(--border);
  }
  .search-results :global(a.is-active) {
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .search-results :global(.sr-kind) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent-wash);
    border-radius: 999px;
    padding: 2px 8px;
    margin-bottom: 6px;
  }
  .search-results :global(.sr-title) {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--heading-weight);
    font-size: 16px;
    line-height: 1.3;
    color: var(--ink);
  }
  .search-results :global(.sr-excerpt) {
    display: block;
    margin-top: 3px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-results :global(mark) {
    background: var(--accent-wash);
    color: var(--accent-ink);
    border-radius: 3px;
    padding: 0 2px;
  }
  .search-results :global(.sr-subs) {
    margin: 2px 0 6px 22px;
    padding-left: 12px;
    border-left: 2px solid var(--border);
    display: grid;
    gap: 2px;
  }
  .search-results :global(a.sr-sub) {
    padding: 6px 10px;
  }
  .search-results :global(.sr-sub-title) {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }
  .search-results :global(a.sr-sub .sr-excerpt) {
    font-size: 12.5px;
    -webkit-line-clamp: 1;
  }
  .search-empty {
    padding: 6px 10px 4px;
  }
  .search-empty[hidden] {
    display: none;
  }
  .search-hint-title {
    margin: 8px 0 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .search-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .search-quick a,
  .search-quick button {
    font: inherit;
    font-size: 13.5px;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 13px;
    cursor: pointer;
  }
  .search-quick a:hover,
  .search-quick button:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .search-fallback {
    margin: 12px 10px;
    color: var(--ink-2);
  }
  .search-foot {
    display: flex;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 12px;
    color: var(--ink-3);
  }
  .search-foot kbd {
    margin-right: 3px;
  }
  @media (max-width: 560px) {
    .search-dialog {
      margin-top: 4vh;
      max-height: 86vh;
    }
    .search-foot {
      display: none;
    }
  }

  /* Show the icon for the theme the button switches TO. */
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  .menu-btn {
    display: none;
  }

  /* Without JavaScript, narrow screens wrap the links onto a second row. */
  @media (max-width: 720px) {
    .nav-inner {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .nav-links {
      order: 3;
      width: 100%;
      margin-left: -10px;
    }
    .theme-btn {
      margin-left: auto;
    }

    /* With JavaScript: a menu button, and the links drop down below the bar. */
    .has-menu .nav-inner {
      flex-wrap: nowrap;
    }
    .has-menu .menu-btn {
      flex: none;
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-left: auto;
      border: 1px solid var(--border);
      border-radius: calc(8px * var(--round, 1));
      background: var(--surface);
      color: var(--ink-2);
      cursor: pointer;
    }
    .has-menu .menu-btn:hover {
      color: var(--ink);
      border-color: var(--border-strong);
    }
    .has-menu .theme-btn {
      margin-left: 0;
    }
    .has-menu .icon-close,
    .has-menu[data-open] .icon-menu {
      display: none;
    }
    .has-menu[data-open] .icon-close {
      display: block;
    }
    .has-menu .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      width: auto;
      flex-direction: column;
      gap: 2px;
      padding: 8px 16px 14px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 12px 24px -16px rgb(0 0 0 / .25);
    }
    .has-menu[data-open] .nav-links {
      display: flex;
    }
    .has-menu .nav-links a {
      font-size: 15px;
      padding: 11px 12px;
    }
  }
</style>
