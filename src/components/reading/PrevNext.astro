---
// Previous / next links at the end of a post or research page.
import type { PageLink } from '../../lib/reading';

interface Props {
  prev?: PageLink;
  next?: PageLink;
  /** e.g. "post" or "research". */
  kind: string;
}

const { prev, next, kind } = Astro.props;
---

{(prev || next) && (
  <nav class="prev-next" aria-label={`More ${kind}`}>
    {prev ? (
      <a class="pn prev" href={prev.href} rel="prev">
        <span class="dir">← Previous {kind}</span>
        <span class="t">{prev.title}</span>
      </a>
    ) : <span />}
    {next && (
      <a class="pn next" href={next.href} rel="next">
        <span class="dir">Next {kind} →</span>
        <span class="t">{next.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    clear: both;
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: calc(12px * var(--round, 1));
    background: var(--surface);
    color: var(--ink);
  }
  .pn:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .next {
    grid-column: 2;
    text-align: right;
  }
  .dir {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .t {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 1.3;
  }
  @media (max-width: 560px) {
    .prev-next {
      grid-template-columns: 1fr;
    }
    .next {
      grid-column: 1;
    }
  }
</style>
