---
// Table of contents for a long page, from its Markdown headings (h2 only).
// Wide screens: a rail in the left margin, as on the explainer pages, with
// the current section marked. Narrower screens: a collapsible "On this page"
// list above the text.

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2);
---

{items.length >= 3 && (
  <>
    <details class="toc-inline">
      <summary>On this page</summary>
      <ol>
        {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </details>
    <nav class="toc-rail" aria-label="On this page">
      <ol>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`} data-toc={h.slug}>
              <span class="pip" aria-hidden="true"></span>
              <span class="lbl">{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </>
)}

<script>
  // Mark the section whose heading most recently crossed the upper part of
  // the window; clicks scroll smoothly unless reduced motion is set.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-rail [data-toc]')];
  if (links.length) {
    const heads = links
      .map((a) => document.getElementById(a.dataset.toc!))
      .filter((h): h is HTMLElement => !!h);
    const setCurrent = (id: string) => {
      for (const a of links) {
        const on = a.dataset.toc === id;
        a.classList.toggle('on', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    const update = () => {
      const line = innerHeight * 0.3;
      let current = heads[0]?.id;
      for (const h of heads) if (h.getBoundingClientRect().top <= line) current = h.id;
      if (current) setCurrent(current);
    };
    let queued = false;
    addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }, { passive: true });
    update();
  }
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.toc-rail a, .toc-inline a')) {
    a.addEventListener('click', (e) => {
      const target = document.getElementById(a.hash.slice(1));
      if (!target) return;
      e.preventDefault();
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', a.hash);
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  }
</script>

<style>
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc-inline {
    margin: 0 0 28px;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 14px;
  }
  .toc-inline summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .toc-inline ol {
    margin-top: 10px;
  }
  .toc-inline li + li {
    margin-top: 6px;
  }
  .toc-inline a {
    color: var(--ink-2);
  }
  .toc-rail {
    display: none;
  }
  @media (min-width: 1180px) {
    .toc-inline {
      display: none;
    }
    .toc-rail {
      display: block;
      position: fixed;
      left: max(16px, calc(50% - 600px));
      top: 50%;
      transform: translateY(-50%);
      z-index: 20;
      will-change: transform;
      max-width: calc(50% - var(--maxw) / 2 - 32px);
    }
    .toc-rail ol {
      display: flex;
      flex-direction: column;
      gap: 11px;
    }
    .toc-rail a {
      display: flex;
      align-items: center;
      gap: 9px;
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.35;
      color: var(--ink-3);
    }
    .toc-rail a:hover {
      color: var(--ink);
      text-decoration: none;
    }
    .pip {
      flex: 0 0 auto;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--border-strong);
      transition: transform .2s;
    }
    .toc-rail a.on .pip {
      background: var(--accent);
      transform: scale(1.3);
    }
    .toc-rail a.on {
      color: var(--ink);
    }
    .lbl {
      opacity: 0;
      transition: opacity .2s;
    }
    .toc-rail:hover .lbl,
    .toc-rail:focus-within .lbl,
    .toc-rail a.on .lbl {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pip,
    .lbl {
      transition: none;
    }
  }
</style>
