---
// Six-stage explainer for the Bird Species Identification bachelor's thesis,
// ported from design-reference/bird-explainer.html. The birds are stylised
// SVG drawings, not CUB-200 photographs; the Stage 5 losses are the thesis's
// logged values; the Stage 6 scores are illustrative.
import { DEMO, SPECIES, birdSvg } from './bird-data';
import { svgBuilder } from './svg';

const START = 'Northern Cardinal';
const start = DEMO[START];

// Stage 1: each bird's idle animation starts at a different point.
const delays = [-0.6, -2.9, -1.7, -4.2, -3.4, -1.1];

// Stage 4: the two backbones (760 × 170), built once; the toggle swaps them.
function archSvg(kind: 'vgg' | 'res') {
  const b = svgBuilder();
  const mono = 'var(--font-mono)';
  const marker = `bird-ah-${kind}`;
  b.raw('<defs>');
  b.marker(marker, 'var(--ink-3)');
  b.raw('</defs>');
  const box = (x: number, y: number, w: number, h: number, o: { fill?: string; stroke?: string } = {}) =>
    b.box(x, y, w, h, { r: 6, fill: o.fill ?? 'var(--surface-2)', stroke: o.stroke ?? 'var(--border)' });
  const arr = (x1: number, x2: number, y: number) => b.arrow(x1, y, x2, y, 'var(--ink-3)', marker);
  box(14, 66, 54, 54, { fill: 'var(--surface)' });
  b.tx(41, 90, 'image', { fs: 10 });
  b.tx(41, 104, '224²·3', { fs: 8, fill: 'var(--ink-3)', ff: mono });
  arr(68, 92, 93);
  const head = (x: number) => {
    box(x, 70, 70, 46, { fill: 'var(--accent-wash)', stroke: 'var(--accent)' });
    b.tx(x + 35, 90, 'FC → 20', { fs: 10, fw: 600, fill: 'var(--accent-ink)' });
    b.tx(x + 35, 104, 'swapped head', { fs: 7.5, fill: 'var(--ink-3)', ff: mono });
  };
  if (kind === 'vgg') {
    const col = 'var(--vgg)';
    let x = 92;
    ['64·64', '128·128', '256³', '512³', '512³'].forEach((blk, i, all) => {
      box(x, 70, 66, 46, { fill: 'var(--vgg-soft)', stroke: col });
      b.tx(x + 33, 92, blk, { fs: 9.5, fw: 600, fill: col });
      b.tx(x + 33, 106, 'conv', { fs: 8, fill: 'var(--ink-3)', ff: mono });
      x += 72;
      if (i < all.length - 1) arr(x - 6, x, 93);
    });
    arr(x - 6, x + 14, 93);
    head(x + 14);
    b.tx(380, 26, 'VGG-16 · 13 conv layers in 5 blocks, then fully-connected', { fs: 10, fill: col, ff: mono, fw: 600 });
    b.tx(380, 44, 'a deep, plain stack of 3×3 convolutions (vgg16_bn)', { fs: 9, fill: 'var(--ink-3)' });
  } else {
    const col = 'var(--res)';
    box(92, 70, 56, 46, { fill: 'var(--res-soft)', stroke: col });
    b.tx(120, 90, '7×7 conv', { fs: 9.5, fw: 600, fill: col });
    b.tx(120, 104, 'stem', { fs: 8, fill: 'var(--ink-3)', ff: mono });
    let x = 164;
    ['64', '128', '256', '512'].forEach((st, i, all) => {
      box(x, 70, 60, 46, { fill: 'var(--res-soft)', stroke: col });
      b.tx(x + 30, 88, `${st} ×2`, { fs: 9.5, fw: 600, fill: col });
      b.tx(x + 30, 102, 'res block', { fs: 7.5, fill: 'var(--ink-3)', ff: mono });
      // Skip connection.
      b.el('path', { d: `M ${x + 6} 70 q 24 -18 48 0`, fill: 'none', 'stroke-width': 1.3, 'stroke-dasharray': '3 3', 'marker-end': `url(#${marker})` }, `stroke:${col}`);
      if (i < all.length - 1) arr(x + 60, x + 72, 93);
      x += 72;
    });
    box(452, 70, 48, 46);
    b.tx(476, 90, 'GAP', { fs: 9.5 });
    b.tx(476, 104, 'pool', { fs: 8, fill: 'var(--ink-3)', ff: mono });
    arr(440, 452, 93);
    arr(500, 512, 93);
    head(512);
    b.tx(380, 26, 'ResNet-18 · 4 stages of residual blocks, then a 20-way head', { fs: 10, fill: col, ff: mono, fw: 600 });
    b.tx(380, 44, 'dashed arcs are skip connections — gradients flow straight through', { fs: 9, fill: 'var(--ink-3)' });
  }
  return b.html();
}
const arch = { vgg: archSvg('vgg'), res: archSvg('res') };
const lock = '<rect x="3" y="7" width="10" height="7" rx="1.5" opacity=".85" style="fill:var(--frozen)"/><path d="M5 7 V5 a3 3 0 0 1 6 0 V7" fill="none" stroke-width="1.6" style="stroke:var(--frozen)"/>';
const mono = 'font-family:var(--font-mono)';
---

<div class="bird-xp" data-start={START}>
  <section class="stage" id="s1" aria-labelledby="s1-title">
    <div class="kick">Stage 1 · The task</div>
    <h2 id="s1-title">Which bird is this?</h2>
    <p>A Blue Jay and an Indigo Bunting are both blue; a House Sparrow and a dozen look-alikes blur together in the field. Telling species apart from a single still photo is a <b>fine-grained</b> recognition problem — the differences are a wing-bar here, an eye-ring there. This project learns to separate <b>20 species</b> drawn from the Caltech-UCSD Birds collection, the standard benchmark for exactly this kind of task.</p>
    <div class="viz">
      <ul class="birdgrid">
        {SPECIES.map((sp, i) => (
          <li class="bcard">
            <svg viewBox="0 0 150 132" width="112" height="98" role="img" aria-label={`A drawing of a ${sp.n}`} set:html={birdSvg(sp, { uid: `g${i}`, delay: delays[i] })} />
            <span class="nm">{sp.n}</span>
          </li>
        ))}
      </ul>
      <p class="note grid-note">The real dataset is photographs; these six are hand-drawn, field-guide style, for illustration — hover and they preen a little.</p>
    </div>
  </section>

  <section class="stage" id="s2" aria-labelledby="s2-title">
    <div class="kick">Stage 2 · The data</div>
    <h2 id="s2-title">A deliberately small dataset</h2>
    <p>The full CUB-200-2011 set is 11,788 photos across 200 species, each annotated with a bounding box. This project worked small on purpose: a <b>20-species slice</b> — just <b>743 training</b> and <b>372 validation</b> images, roughly <b>37 photos per species</b>. Every image is cropped to the bird's bounding box so the background can't leak in, resized to <b>224 × 224</b>, and normalised to the range the pretrained network expects. With this little data, a deep network trained from scratch would simply memorise the training set — the "curse of dimensionality."</p>
    <div class="viz">
      <div class="datarow">
        <div class="photo-col">
          <div class="photo">
            <svg viewBox="0 0 150 132" width="200" height="150" role="img" aria-label="A drawn Blue Jay with its bounding box">
              <Fragment set:html={birdSvg(SPECIES[0], { uid: 'crop', delay: -2.2, branch: false })} />
              <rect x="14" y="30" width="120" height="74" rx="3" fill="none" stroke-width="2" stroke-dasharray="5 4" style="stroke:var(--accent)" />
              <text x="132" y="24" text-anchor="end" font-size="9" style={`fill:var(--accent-ink);${mono}`}>bounding box</text>
            </svg>
          </div>
          <div class="note photo-note">crop to box → 224×224×3</div>
        </div>
        <div class="split"><div class="big">743</div><div class="lab">training images</div></div>
        <div class="split"><div class="big">372</div><div class="lab">validation images</div></div>
      </div>
    </div>
  </section>

  <section class="stage" id="s3" aria-labelledby="s3-title">
    <div class="kick">Stage 3 · Transfer learning</div>
    <h2 id="s3-title">Borrow a network that already knows how to see</h2>
    <p>A network starting from zero on 743 images has nothing to go on. So the project borrows one that has already studied <b>1.2 million</b>: a backbone pre-trained on ImageNet's 1,000 everyday categories. Its early layers already detect edges, textures and feather-like patterns — vision that transfers straight to birds. Those layers are <b>frozen</b> (their weights locked), and only a fresh final classifier — mapping features to the 20 species — is trained. Far fewer parameters to fit means it converges in a handful of epochs instead of overfitting the tiny set.</p>
    <div class="viz">
      <div class="tl">
        <div class="block frozen">
          <div class="t">❄ Pre-trained backbone</div>
          <div class="s">ImageNet features — kept frozen</div>
          <div class="lockrow" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => <svg width="16" height="16" viewBox="0 0 16 16" set:html={lock} />)}
          </div>
        </div>
        <div class="tl-arrow" aria-hidden="true">→</div>
        <div class="block trainable">
          <div class="t">New classifier head</div>
          <div class="s">Linear → 20 species — trained</div>
        </div>
      </div>
      <p class="note center spaced">Only the small head learns at first — a few thousand new weights instead of millions.</p>
    </div>
  </section>

  <section class="stage" id="s4" aria-labelledby="s4-title">
    <div class="kick">Stage 4 · Two backbones</div>
    <h2 id="s4-title">VGG-16 or ResNet-18?</h2>
    <p>Two backbones were tried head-to-head. <b class="c-vgg">VGG-16</b> (the <code>vgg16_bn</code> variant, with batch-norm) is a tall, plain stack — 13 convolution layers in five blocks, then large fully-connected layers. <b class="c-res">ResNet-18</b> is shallower but smarter: its <b>residual skip connections</b> add each block's input back to its output, so gradients flow straight through and the network trains cleanly. In both, only the final layer is swapped for a clean <code>Linear → 20</code>.</p>
    <div class="viz">
      <div class="seg" role="group" aria-label="Backbone">
        <button type="button" data-b="vgg" aria-pressed="true">VGG-16</button>
        <button type="button" data-b="res" aria-pressed="false">ResNet-18</button>
      </div>
      <svg class="diagram" data-arch="vgg" viewBox="0 0 760 170" role="img" aria-label="VGG-16: five convolution blocks, then a swapped fully-connected head with 20 outputs" set:html={arch.vgg} />
      <svg class="diagram" data-arch="res" viewBox="0 0 760 170" role="img" aria-label="ResNet-18: a 7×7 convolution stem, four stages of residual blocks with skip connections, global average pooling, then a swapped 20-way head" hidden set:html={arch.res} />
    </div>
  </section>

  <section class="stage" id="s5" aria-labelledby="s5-title">
    <div class="kick">Stage 5 · Two-phase training</div>
    <h2 id="s5-title">Freeze, then fine-tune</h2>
    <p>Training ran in two phases. <b class="c-frozen">Phase 1</b> freezes the backbone and trains only the head for 20 epochs at learning rate 0.001 — loss drops from 5.3 to under 1 almost at once, and accuracy leaps from <b>0.5%</b> (random guessing over 20 classes) to <b>79.9% after a single epoch</b>. <b class="c-acc">Phase 2</b> unfreezes everything and fine-tunes the whole network for 20 more epochs at a gentler 0.0001, letting the backbone adapt to birds. Adam optimiser, weight decay 1e-6, gradient clipping at 1.0, on a one-cycle schedule.</p>
    <div class="viz">
      <div class="phases">
        <div class="phase p1"><div class="h">PHASE 1 · FROZEN · 20 epochs</div><div class="d">Only the classifier head learns. lr 0.001.</div></div>
        <div class="phase p2"><div class="h">PHASE 2 · FINE-TUNE · 20 epochs</div><div class="d">Whole network unfrozen. lr 0.0001.</div></div>
      </div>
      <canvas class="curve" width="760" height="300" role="img" aria-label="Training loss falling from 1.58 to 0.06 over 20 epochs while validation loss flattens near 0.5"></canvas>
      <div class="legend"><span><i style="background:var(--accent)"></i>training loss</span><span><i style="background:var(--vgg)"></i>validation loss</span></div>
      <p class="note center curve-note">The actual logged loss from the thesis — training loss falls 1.58 → 0.06, while validation loss flattens near 0.5.</p>
      <div class="acc-anchors">
        <div class="anchor"><div class="n">0.5%</div><div class="l">accuracy at init</div></div>
        <div class="anchor"><div class="n">79.9%</div><div class="l">after epoch 1</div></div>
        <div class="anchor"><div class="n">~100%</div><div class="l">training accuracy</div></div>
        <div class="anchor"><div class="n">low-80s%</div><div class="l">validation (plateau)</div></div>
      </div>
      <p class="note center spaced">Training accuracy climbs toward 100% while validation plateaus in the low-80s — that gap is the small-data ceiling, honestly reported.</p>
    </div>
  </section>

  <section class="stage" id="s6" aria-labelledby="s6-title">
    <div class="kick">Stage 6 · The prediction</div>
    <h2 id="s6-title">A top-5 score sheet</h2>
    <p>For a given photo the model scores every species; the five highest make the score sheet, and the top one is the answer. Pick a bird to see an example — notice the model's doubt lands on genuinely similar species (the two blues, the streaky browns). <span class="note">(Illustrative outputs in the shape of a confident prediction — not live inference.)</span></p>
    <div class="viz">
      <div class="pred">
        <div class="leftcol">
          <svg data-ref="bird" viewBox="0 0 150 132" width="180" height="158" role="img" aria-label={`A drawing of a ${START}`} set:html={birdSvg(SPECIES[start.sp], { uid: 'pred0', delay: -1.3, branch: false })} />
          <div class="pick" role="group" aria-label="Bird">
            {SPECIES.map((sp) => (
              <button type="button" data-name={sp.n} aria-pressed={sp.n === START ? 'true' : 'false'}>{sp.n}</button>
            ))}
          </div>
        </div>
        <div class="bars">
          {start.top.map(([name, p], i) => (
            <div class:list={['bar', { win: i === 0 }]} data-row={i}>
              <span class="nm">{name}</span>
              <span class="track"><span class="fill" style={`--p:${p}`}></span></span>
              <span class="pct">{p}%</span>
            </div>
          ))}
          <p class="verdict" aria-live="polite">Top match: <b data-ref="verdict">{START}</b></p>
        </div>
      </div>
      <ul class="limits">
        <li>Samples per species were uneven, so the model favoured some birds over others.</li>
        <li>Accuracy drops at awkward camera angles and with lower-quality photos — a finding noted in the thesis.</li>
        <li>With only ~37 images per species, the low-80s validation accuracy is a small-data result, not a production one.</li>
        <li>Next step the thesis proposes: a phone app (iOS/Android) and camera-trap deployment for wildlife monitoring.</li>
      </ul>
    </div>
  </section>
</div>

<script>
  import { DEMO, SPECIES, TRAIN, VALID, birdSvg } from './bird-data';
  import { onThemeChange, revealStages } from './explainer';

  const root = document.querySelector<HTMLElement>('.bird-xp');
  if (root) {
    revealStages(root.closest('.xp') ?? root);
    const css = (n: string) => getComputedStyle(root).getPropertyValue(n).trim();

    // Stage 4: VGG-16 ↔ ResNet-18.
    const segBtns = [...root.querySelectorAll<HTMLButtonElement>('.seg button')];
    for (const b of segBtns) {
      b.addEventListener('click', () => {
        for (const x of segBtns) x.setAttribute('aria-pressed', String(x === b));
        root.querySelectorAll<SVGSVGElement>('[data-arch]').forEach((s) => s.toggleAttribute('hidden', s.dataset.arch !== b.dataset.b));
      });
    }

    // Stage 5: the logged training and validation loss, redrawn for the theme.
    const cv = root.querySelector<HTMLCanvasElement>('canvas.curve');
    function drawCurve() {
      const ctx = cv?.getContext('2d');
      if (!cv || !ctx) return;
      const W = 760, H = 300, pl = 46, pb = 34, pt = 14, pr = 14;
      const dpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
      cv.width = W * dpr;
      cv.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      const ink3 = css('--ink-3'), border = css('--border'), acc = css('--accent'), vgg = css('--vgg');
      const maxL = 1.6, n = TRAIN.length;
      const X = (i: number) => pl + (W - pl - pr) * (i / (n - 1));
      const Y = (v: number) => pt + (H - pt - pb) * (1 - v / maxL);
      ctx.strokeStyle = border;
      ctx.lineWidth = 1;
      ctx.fillStyle = ink3;
      ctx.font = `11px ${css('--font-mono') || 'monospace'}`;
      for (let g = 0; g <= 4; g++) {
        const v = g * 0.4, y = Y(v);
        ctx.globalAlpha = 0.5;
        ctx.beginPath(); ctx.moveTo(pl, y); ctx.lineTo(W - pr, y); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.textAlign = 'right';
        ctx.fillText(v.toFixed(1), pl - 6, y + 3);
      }
      ctx.textAlign = 'center';
      for (const e of [1, 5, 10, 15, 20]) ctx.fillText(String(e), X(e - 1), H - pb + 16);
      ctx.fillText('epoch', W / 2, H - 4);
      const plot = (arr: number[], color: string) => {
        ctx.strokeStyle = color;
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        arr.forEach((v, i) => (i ? ctx.lineTo(X(i), Y(v)) : ctx.moveTo(X(i), Y(v))));
        ctx.stroke();
        ctx.fillStyle = color;
        arr.forEach((v, i) => { ctx.beginPath(); ctx.arc(X(i), Y(v), 2.4, 0, 7); ctx.fill(); });
      };
      plot(VALID, vgg);
      plot(TRAIN, acc);
    }
    drawCurve();
    onThemeChange(drawCurve);

    // Stage 6: pick a bird; the drawing and the top-5 follow.
    const birdEl = root.querySelector('[data-ref="bird"]');
    const pickBtns = [...root.querySelectorAll<HTMLButtonElement>('.pick button')];
    let n = 0;
    function select(name: string) {
      const d = DEMO[name];
      for (const b of pickBtns) b.setAttribute('aria-pressed', String(b.dataset.name === name));
      if (birdEl) {
        birdEl.innerHTML = birdSvg(SPECIES[d.sp], { uid: `pred${++n}`, delay: -1.3, branch: false });
        birdEl.setAttribute('aria-label', `A drawing of a ${name}`);
      }
      d.top.forEach(([label, p], i) => {
        const row = root!.querySelector<HTMLElement>(`[data-row="${i}"]`);
        if (!row) return;
        row.classList.toggle('win', i === 0);
        const nm = row.querySelector('.nm'), fill = row.querySelector<HTMLElement>('.fill'), pct = row.querySelector('.pct');
        if (nm) nm.textContent = label;
        fill?.style.setProperty('--p', String(p));
        if (pct) pct.textContent = `${p}%`;
      });
      const verdict = root!.querySelector('[data-ref="verdict"]');
      if (verdict) verdict.textContent = name;
    }
    for (const b of pickBtns) b.addEventListener('click', () => select(b.dataset.name!));
  }
</script>

<style>
  /* This page's diagram colours, named as in the reference. Same values as
     the site's diagram tokens, so they follow day/night with them. */
  .bird-xp {
    --vgg: var(--ctrl);
    --vgg-soft: var(--ctrl-soft);
    --res: var(--aud);
    --res-soft: var(--aud-soft);
    --frozen: var(--vit);
    --frozen-soft: var(--vit-soft);
  }
  .bird-xp .stage p b.c-vgg { color: var(--vgg); }
  .bird-xp .stage p b.c-res { color: var(--res); }
  .bird-xp .stage p b.c-frozen { color: var(--frozen); }
  .bird-xp .stage p b.c-acc { color: var(--accent-ink); }
  .bird-xp .stage .note.spaced { margin: 12px 0 0; }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Stage 1 */
  .birdgrid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 118px;
  }
  .bcard .nm {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-2);
    text-align: center;
  }
  .bird-xp .stage .grid-note { margin: 12px 0 0; }

  /* Stage 2 */
  .datarow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }
  .photo-col { text-align: center; }
  .photo {
    width: 200px;
    height: 150px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .photo svg { display: block; }
  .bird-xp .stage .photo-note { margin-top: 6px; }
  .split {
    flex: 1 1 140px;
    max-width: 200px;
    text-align: center;
  }
  .split .big {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    color: var(--accent-ink);
  }
  .split .lab {
    font-size: 12.5px;
    color: var(--ink-2);
  }

  /* Stage 3 */
  .tl {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 10px;
  }
  .tl-arrow {
    display: flex;
    align-items: center;
    font-size: 20px;
    color: var(--ink-3);
  }
  .block {
    flex: 1 1 150px;
    min-width: 150px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    text-align: center;
  }
  .block.frozen { background: var(--frozen-soft); border-color: var(--frozen); }
  .block.trainable { background: var(--accent-wash); border-color: var(--accent); }
  .block .t {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .block.frozen .t { color: var(--frozen); }
  .block.trainable .t { color: var(--accent-ink); }
  .block .s {
    font-size: 11.5px;
    color: var(--ink-2);
    margin-top: 4px;
  }
  .lockrow {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 8px;
  }

  /* Stage 4 */
  .seg {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin-bottom: 12px;
    border-radius: 10px;
    background: var(--surface-2);
  }
  .seg button {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-2);
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 7px 14px;
    cursor: pointer;
  }
  .seg button[aria-pressed='true'] { color: #fff; }
  .seg button[aria-pressed='true'][data-b='vgg'] { background: var(--vgg); }
  .seg button[aria-pressed='true'][data-b='res'] { background: var(--res); }
  .bird-xp .diagram[hidden] { display: none; }

  /* Stage 5 */
  .phases {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }
  .phase {
    flex: 1 1 230px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    background: var(--surface-2);
  }
  .phase .h {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .03em;
  }
  .phase.p1 .h { color: var(--frozen); }
  .phase.p2 .h { color: var(--accent-ink); }
