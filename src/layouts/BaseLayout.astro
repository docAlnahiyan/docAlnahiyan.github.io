---
// Self-hosted fonts (no request to Google Fonts): only the faces the site
// uses. Each @font-face has font-display: swap.
import FontFaces from '../components/FontFaces.astro';
import '../styles/global.css';
import { getTheme, themeCss } from '../lib/theme';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ANALYTICS, SITE } from '../site';
import { serializeLd } from '../lib/jsonld';
import { ogKey, ogPages } from '../lib/og';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Social preview image (1200×630); defaults to the site-wide image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** schema.org structured data (see src/lib/jsonld.ts). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const theme = await getTheme();
const appearanceCss = themeCss(theme);

// A page's own image wins; otherwise its generated card (src/lib/og.ts);
// otherwise the site-wide image.
const card = (await ogPages()).get(Astro.url.pathname.replace(/\/?$/, '/'));
const generated = card ? `/og/${ogKey(Astro.url.pathname.replace(/\/?$/, '/'))}.png` : undefined;

const {
  title,
  description = SITE.description,
  image = generated ?? SITE.ogImage,
  imageAlt = card ? `${card.kind}: ${card.title} · Al-Nahiyan Khushbu` : SITE.ogImageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// The site name is appended only while the whole title stays within what
// search results show (~60 characters).
const TITLE_MAX = 60;
const withSite = title ? `${title} · ${SITE.name}` : SITE.name;
const fullTitle = title && withSite.length > TITLE_MAX ? title : withSite;

// Analytics (ANALYTICS in src/site.ts): cookieless page counts, never loaded
// for visitors with Do Not Track or Global Privacy Control switched on, nor
// on localhost.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site).href;
// Both the default image and the generated cards are 1200×630.
const isDefaultImage = image === SITE.ogImage || image === generated;
---

<!doctype html>
<html lang="en">
  <head>
    <FontFaces />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={serializeLd(jsonLd)} />}

    {ANALYTICS.enabled && (
      <script is:inline define:vars={{ domain: ANALYTICS.domain, src: ANALYTICS.src }}>
        (function () {
          var dnt = navigator.doNotTrack === '1' || window.doNotTrack === '1' || navigator.globalPrivacyControl === true;
          if (dnt || location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;
          var s = document.createElement('script');
          s.defer = true;
          s.src = src;
          s.dataset.domain = domain;
          document.head.appendChild(s);
        })();
      </script>
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content={theme.light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={theme.dark.bg} media="(prefers-color-scheme: dark)" />
    <style is:inline set:html={appearanceCss}></style>

    <!-- Apply a saved theme before first paint so there is no flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
