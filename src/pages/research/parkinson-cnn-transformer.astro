---
// Research theme page for the 2D Parkinson's paper (IARCE 2024), ported from
// design-reference/parkinson-explainer.html (spec: parkinson-page-spec.md).
// Replaces the generated page of research entry
// parkinsons-hybrid-cnn-transformer-2d, whose old address redirects here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParkinsonExplainer from '../../components/research/ParkinsonExplainer.astro';
---

<BaseLayout
  title="Reading Parkinson's from a brain MRI"
  description="A hybrid CNN–Transformer that sorts a structural brain scan into Control, Prodromal, or Parkinson's — followed stage by stage from the PPMI archive to a prediction. IARCE 2024 Best Paper."
  type="article"
>
  <article class="wrap view research">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/research/">Research</a> <span aria-hidden="true">›</span> <span aria-current="page">Parkinson's from brain MRI</span>
    </nav>
    <ul class="chips">
      <li class="chip award">Best Paper · IARCE 2024</li>
      <li class="chip">Medical imaging</li>
      <li class="chip">CNN + Transformer</li>
      <li class="chip">PPMI</li>
    </ul>
    <h1 class="title">Reading Parkinson's from a brain MRI</h1>
    <p class="plain">A hybrid CNN–Transformer that sorts a structural brain scan into Control, Prodromal, or Parkinson's — and shows where it looked.</p>
    <p class="authors"><b>Al-Nahiyan Khushbu</b>, Yang, Liu &amp; Zhang · 80.5% accuracy, AUC 0.84</p>
    <p class="intro-note">Walk down the page to follow one scan from the archive to a prediction. Scrub, switch cohorts, and toggle the attention map as you go.</p>

    <ParkinsonExplainer />
  </article>
</BaseLayout>

<style>
  .research {
    max-width: 900px;
  }
  .crumb {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-3);
    margin-bottom: 18px;
  }
  .crumb a {
    color: var(--ink-3);
  }
  .crumb a:hover {
    color: var(--accent-ink);
  }
  .crumb span[aria-hidden] {
    margin: 0 .4em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink-2);
  }
  .chip.award {
    background: var(--accent-wash);
    border-color: transparent;
    color: var(--accent-ink);
    font-weight: 500;
  }
  .title {
    font-weight: 600;
    font-size: clamp(28px, 5vw, 33px);
    line-height: 1.18;
    margin: 0 0 10px;
  }
  .plain {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    color: var(--ink-2);
    margin: 0 0 14px;
  }
  .authors {
    font-size: 14px;
    color: var(--ink-2);
    margin: 0 0 6px;
  }
  .authors b {
    color: var(--ink);
    font-weight: 600;
  }
  .intro-note {
    font-size: 12.5px;
    font-style: italic;
    color: var(--ink-3);
    margin: 0 0 8px;
  }
</style>
