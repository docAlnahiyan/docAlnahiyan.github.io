---
// Home: the animated sketch hero (design-reference/landing-scene-spec.md), then
// About with the research-focus card, then the wider "At a glance" row.
// Other pages keep the narrow reading width.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import { getProfile, getPublications, getProjects, getPosts, getUpworkItems } from '../lib/content';
import {
  cumulativeSpark,
  inlineMarkdown,
  monthYear,
  publicationBreakdown,
  publicationsByYear,
} from '../lib/format';

const profile = await getProfile();
const [pubs, projects, posts, upwork] = await Promise.all([
  getPublications(),
  getProjects(),
  getPosts(),
  getUpworkItems(),
]);

const latest = (dates: Date[]) =>
  dates.length ? monthYear(new Date(Math.max(...dates.map((d) => +d)))) : undefined;

// Every number here is counted from the content files. A card with nothing to
// count yet is left out rather than shown as zero.
const cards = [
  {
    key: 'Publications',
    href: '/publications/',
    count: pubs.length,
    meta: publicationBreakdown(pubs),
    spark: cumulativeSpark(pubs.map((p) => p.data.date ?? new Date(Date.UTC(p.data.year, 0, 1)))),
  },
  {
    key: 'Projects',
    href: '/projects/',
    count: projects.length,
    meta: latest(projects.map((p) => p.data.date)) && `latest: ${latest(projects.map((p) => p.data.date))}`,
    spark: cumulativeSpark(projects.map((p) => p.data.date)),
  },
  {
    key: 'Blog posts',
    href: '/blog/',
    count: posts.length,
    meta: latest(posts.map((p) => p.data.date)) && `latest: ${latest(posts.map((p) => p.data.date))}`,
    spark: cumulativeSpark(posts.map((p) => p.data.date)),
  },
  {
    key: 'Upwork',
    href: '/upwork/',
    count: upwork.length,
    meta: 'applied ML & data work',
    spark: undefined,
  },
].filter((c) => c.count > 0);

const years = publicationsByYear(pubs);
const maxPerYear = Math.max(1, ...years.map((y) => y.total));
const BAR_MAX = 104; // px
const segPx = (n: number) => Math.round((n / maxPerYear) * BAR_MAX);
const yearLabel = (y: (typeof years)[number]) =>
  [
    `${y.year}: ${y.total} paper${y.total === 1 ? '' : 's'}`,
    y.published && `${y.published} published`,
    y.underReview && `${y.underReview} under review`,
    y.preprint && `${y.preprint} preprint`,
  ]
    .filter(Boolean)
    .join(', ');

// Stat cards take one share each and the chart two, whatever the card count.
const glanceColumns =
  years.length > 0
    ? `repeat(${cards.length}, minmax(0, 1fr)) minmax(0, 2fr)`
    : `repeat(${cards.length}, minmax(0, 1fr))`;

const { links } = profile;
const aboutLinks = [
  { label: 'CV', href: links.cv },
  { label: 'ORCID', href: links.orcid },
  { label: 'Google Scholar', href: links.scholar },
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const facts = [
  { label: 'Area', value: profile.research_area },
  { label: 'Methods', value: profile.methods },
  { label: 'Based in', value: profile.location },
  { label: 'Since', value: profile.active_since },
].filter((f): f is { label: string; value: string } => Boolean(f.value));

const plainBio = profile.bio.replace(/\*\*/g, '');
---

<BaseLayout description={`${profile.name} — ${plainBio}`}>
  <HeroScene
    name={profile.name}
    bio={[profile.role, profile.affiliation].filter(Boolean).join(' at ')}
  />

  <section class="wide about" id="about" aria-labelledby="about-head">
    <div class="intro">
      <h2 id="about-head" class="k">About</h2>
      <p class="bio" set:html={inlineMarkdown(profile.bio)} />
      <ul class="links">
        {aboutLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><span class="selectable">{links.email}</span></li>
      </ul>
    </div>

    {facts.length > 0 && (
      <aside class="focus" aria-labelledby="focus-label">
        <div class="focus-head">
          <span class="avatar">
            {profile.photo ? (
              <img src={profile.photo} alt="" width="58" height="58" />
            ) : (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="9" r="3.6" /><path d="M5.5 19c0-3.3 2.9-5 6.5-5s6.5 1.7 6.5 5" /></svg>
            )}
          </span>
          <div>
            <h2 id="focus-label" class="k">Research focus</h2>
            <p class="focus-name">{profile.name}</p>
          </div>
        </div>
        <dl class="facts">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    )}
  </section>

  <section class="wide glance-section" aria-labelledby="glance">
    <h2 id="glance" class="glance-head">At a glance</h2>
    <div class="glance" style={`grid-template-columns: ${glanceColumns}`}>
      {cards.map((c) => (
        <a class="stat" href={c.href}>
          <span class="k">{c.key}</span>
          <span class="v">{c.count}</span>
          {c.spark && (
            <svg class="spark" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
              <polyline points={c.spark} fill="none" stroke="currentColor" stroke-width="2.5" vector-effect="non-scaling-stroke" />
            </svg>
          )}
          {c.meta && <span class="meta">{c.meta}</span>}
        </a>
      ))}

      {years.length > 0 && (
        <figure class="chart">
          <figcaption>
            <h3>Publications by year</h3>
            <p class="sub">Counted from the publication list. Papers under review and preprints are not yet peer-reviewed.</p>
          </figcaption>
          <ol class="bars">
            {years.map((y) => (
              <li class="bar-col">
                <span class="visually-hidden">{yearLabel(y)}</span>
                <span class="bar" aria-hidden="true">
                  {y.total === 0 && <span class="seg none" />}
                  {y.preprint > 0 && <span class="seg pre" style={`height:${segPx(y.preprint)}px`} />}
                  {y.underReview > 0 && <span class="seg rev" style={`height:${segPx(y.underReview)}px`} />}
                  {y.published > 0 && <span class="seg pub" style={`height:${segPx(y.published)}px`} />}
                </span>
                <span class="n" aria-hidden="true">{y.total}</span>
                <span class="yr" aria-hidden="true">{y.year}</span>
              </li>
            ))}
          </ol>
          <ul class="legend" aria-hidden="true">
            <li><span class="sw pub" />Published</li>
            <li><span class="sw rev" />Under review</li>
            <li><span class="sw pre" />Preprint</li>
          </ul>
        </figure>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Home content uses the same wide width as the nav and footer; reading
     pages keep the narrow --maxw column. */
  .wide {
    max-width: var(--maxw-wide);
    margin-inline: auto;
    padding-inline: 24px;
  }

  /* ---------- about (sits just below the hero) ---------- */
  .about {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
    align-items: start;
    padding-block: 56px 8px;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 44px 8px;
    }
  }
  .about .k {
    margin-bottom: 14px;
  }

  .bio {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 34ch;
    margin: 0 0 28px;
  }
  .bio :global(b) {
    color: var(--ink);
    font-weight: 600;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13.5px;
  }
  .links a {
    color: var(--ink-2);
  }
  .links a:hover {
    color: var(--accent-ink);
  }
  .selectable {
    color: var(--ink);
    user-select: all;
  }

  /* ---------- research focus card ---------- */
  .focus {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px;
  }
  .focus-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .avatar {
    flex: none;
    width: 58px;
    height: 58px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    display: grid;
    place-items: center;
    color: var(--ink-3);
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .k {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .focus-name {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink);
    margin: 3px 0 0;
  }
  .facts {
    margin: 0;
  }
  .fact {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  .fact:first-child {
    border-top: none;
  }
  .fact dt {
    color: var(--ink-3);
  }
  .fact dd {
    margin: 0;
    color: var(--ink);
    text-align: right;
  }

  /* ---------- at a glance ---------- */
  .glance-section {
    padding-block: 48px 72px;
  }
  .glance-head {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: .01em;
    margin-bottom: 18px;
  }
  .glance {
    display: grid;
    gap: 16px;
  }
  @media (max-width: 760px) {
    .glance {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    .chart {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 460px) {
    .glance {
      grid-template-columns: minmax(0, 1fr) !important;
    }
  }

  .stat {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
    color: var(--accent);
    transition: border-color .15s;
  }
  .stat:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .stat .v {
    display: block;
    font-family: var(--font-display);
    font-size: 48px;
    color: var(--ink);
    line-height: 1;
    margin: 12px 0 14px;
    font-variant-numeric: tabular-nums;
  }
  .spark {
    display: block;
    width: 100%;
    height: 34px;
  }
  .stat .meta {
    display: block;
    font-size: 13px;
    color: var(--ink-3);
    margin-top: 12px;
  }

  .chart {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
  }
  .chart h3 {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 2px;
  }
  .chart .sub {
    font-size: 12px;
    color: var(--ink-3);
    margin: 0 0 20px;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 22px;
    height: 150px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    height: 100%;
    justify-content: flex-end;
  }
  .bar {
    width: 100%;
    max-width: 70px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .seg {
    display: block;
    width: 100%;
  }
  .seg:first-child {
    border-radius: 4px 4px 0 0;
  }
  .seg.pub {
    background: var(--accent-ink);
  }
  .seg.rev {
    background: var(--warn);
  }
  .seg.pre {
    background: repeating-linear-gradient(45deg, var(--ink-3) 0 3px, transparent 3px 6px);
    border: 1px solid var(--ink-3);
  }
  .seg.none {
    height: 2px;
    background: var(--border-strong);
    border-radius: 0;
  }
  .bar-col .n,
  .bar-col .yr {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .bar-col .n {
    color: var(--ink-2);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    display: inline-block;
  }
  .sw.pub {
    background: var(--accent-ink);
  }
  .sw.rev {
    background: var(--warn);
  }
  .sw.pre {
    background: repeating-linear-gradient(45deg, var(--ink-3) 0 2px, transparent 2px 4px);
    border: 1px solid var(--ink-3);
  }
</style>
