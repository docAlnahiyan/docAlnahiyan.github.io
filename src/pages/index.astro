---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile, getPublications, getProjects, getPosts, getUpworkItems } from '../lib/content';
import {
  cumulativeSpark,
  inlineMarkdown,
  monthYear,
  publicationBreakdown,
  publicationsByYear,
} from '../lib/format';

const profile = await getProfile();
const [pubs, projects, posts, upwork] = await Promise.all([
  getPublications(),
  getProjects(),
  getPosts(),
  getUpworkItems(),
]);

const latest = (dates: Date[]) =>
  dates.length ? monthYear(new Date(Math.max(...dates.map((d) => +d)))) : undefined;

// Every number here is counted from the content files. A card with nothing to
// count yet is left out rather than shown as zero.
const cards = [
  {
    key: 'Publications',
    href: '/publications/',
    count: pubs.length,
    meta: publicationBreakdown(pubs),
    spark: cumulativeSpark(pubs.map((p) => p.data.date ?? new Date(Date.UTC(p.data.year, 0, 1)))),
  },
  {
    key: 'Projects',
    href: '/projects/',
    count: projects.length,
    meta: latest(projects.map((p) => p.data.date)) && `latest: ${latest(projects.map((p) => p.data.date))}`,
    spark: cumulativeSpark(projects.map((p) => p.data.date)),
  },
  {
    key: 'Blog posts',
    href: '/blog/',
    count: posts.length,
    meta: latest(posts.map((p) => p.data.date)) && `latest: ${latest(posts.map((p) => p.data.date))}`,
    spark: cumulativeSpark(posts.map((p) => p.data.date)),
  },
  {
    key: 'Upwork',
    href: '/upwork/',
    count: upwork.length,
    meta: 'applied ML & data work',
    spark: undefined,
  },
].filter((c) => c.count > 0);

const years = publicationsByYear(pubs);
const maxPerYear = Math.max(1, ...years.map((y) => y.total));
const BAR_MAX = 96; // px
const segPx = (n: number) => Math.round((n / maxPerYear) * BAR_MAX);
const yearLabel = (y: (typeof years)[number]) =>
  [
    `${y.year}: ${y.total} paper${y.total === 1 ? '' : 's'}`,
    y.published && `${y.published} published`,
    y.underReview && `${y.underReview} under review`,
    y.preprint && `${y.preprint} preprint`,
  ]
    .filter(Boolean)
    .join(', ');

const { links } = profile;
const heroLinks = [
  { label: 'CV', href: links.cv },
  { label: 'Google Scholar', href: links.scholar },
  { label: 'ORCID', href: links.orcid },
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const plainBio = profile.bio.replace(/\*\*/g, '');
---

<BaseLayout description={`${profile.name} — ${plainBio}`}>
  <div class="wrap view">
    <section class="hero" aria-labelledby="hero-name">
      <svg class="hero-art" viewBox="0 0 200 180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M70 30c-22 0-40 16-40 38 0 8 3 15 7 21-3 5-4 11-2 17 3 10 13 16 24 15 5 9 15 15 26 15 18 0 33-13 35-31" stroke-opacity=".9" />
        <path d="M70 30c14-10 34-8 45 4 6 7 9 16 8 25 7 6 11 15 9 24-2 11-12 19-24 19" stroke-opacity=".6" />
        <circle cx="66" cy="62" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="92" cy="50" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="110" cy="74" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="80" cy="92" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="104" cy="104" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="60" cy="100" r="3.2" fill="currentColor" stroke="none" />
        <path d="M66 62l26-12M92 50l18 24M110 74l-30 18M80 92l24 12M80 92l-20 8M66 62l14 30" stroke-opacity=".45" />
      </svg>
      <h1 id="hero-name">{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="lede" set:html={inlineMarkdown(profile.bio)} />
      <ul class="links-row">
        {heroLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><span class="selectable">{links.email}</span></li>
      </ul>
    </section>

    <section aria-labelledby="glance">
      <div class="section-label">
        <h2 id="glance">At a glance</h2>
      </div>
      <ul class="cards">
        {cards.map((c) => (
          <li>
            <a class="card" href={c.href}>
              <span class="k">{c.key}</span>
              <span class="v">{c.count}</span>
              {c.spark && (
                <svg class="spark" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
                  <polyline points={c.spark} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
                </svg>
              )}
              {c.meta && <span class="meta">{c.meta}</span>}
            </a>
          </li>
        ))}
      </ul>

      {years.length > 0 && (
        <figure class="panel">
          <figcaption>
            <h3>Publications by year</h3>
            <p class="sub">Counted from the publication list. Papers under review and preprints are not yet peer-reviewed.</p>
          </figcaption>
          <ol class="bars">
            {years.map((y) => (
              <li class="bar-col">
                <span class="visually-hidden">{yearLabel(y)}</span>
                <span class="n" aria-hidden="true">{y.total}</span>
                <span class="bar" aria-hidden="true">
                  {y.preprint > 0 && <span class="seg pre" style={`height:${segPx(y.preprint)}px`} />}
                  {y.underReview > 0 && <span class="seg rev" style={`height:${segPx(y.underReview)}px`} />}
                  {y.published > 0 && <span class="seg pub" style={`height:${segPx(y.published)}px`} />}
                </span>
                <span class="yr" aria-hidden="true">{y.year}</span>
              </li>
            ))}
          </ol>
          <ul class="legend" aria-hidden="true">
            <li><span class="sw pub" />Published</li>
            <li><span class="sw rev" />Under review</li>
            <li><span class="sw pre" />Preprint</li>
          </ul>
        </figure>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: 28px 10px;
    overflow: hidden;
  }
  .hero-art {
    position: absolute;
    right: -40px;
    top: -20px;
    width: 300px;
    max-width: 55%;
    opacity: .5;
    pointer-events: none;
    color: var(--accent);
  }
  :global(:root[data-theme='dark']) .hero-art {
    opacity: .32;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hero-art {
      opacity: .32;
    }
  }
  .hero h1 {
    position: relative;
    font-size: clamp(34px, 6vw, 52px);
    letter-spacing: -.02em;
    margin-bottom: 6px;
  }
  .role {
    position: relative;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-2);
    letter-spacing: .02em;
    margin: 0 0 22px;
  }
  .lede {
    position: relative;
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 24px;
  }
  .lede :global(b) {
    color: var(--ink);
    font-weight: 600;
  }
  .links-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .links-row a {
    color: var(--ink-2);
  }
  .links-row a:hover {
    color: var(--accent-ink);
  }
  .selectable {
    color: var(--ink);
    user-select: all;
  }

  .section-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 56px 0 16px;
  }
  .section-label h2 {
    font-size: 15px;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: .01em;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: block;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 16px 14px;
    color: var(--accent);
    transition: border-color .15s;
  }
  .card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .card .k {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .card .v {
    display: block;
    font-family: var(--font-display);
    font-size: 34px;
    color: var(--ink);
    line-height: 1;
    margin: 8px 0 10px;
    font-variant-numeric: tabular-nums;
  }
  .spark {
    display: block;
    width: 100%;
    height: 28px;
  }
  .card .meta {
    display: block;
    font-size: 12px;
    color: var(--ink-3);
    margin-top: 8px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 18px 14px;
    margin: 12px 0 0;
  }
  .panel h3 {
    font-size: 14px;
    font-family: var(--font-body);
    font-weight: 600;
    margin-bottom: 2px;
  }
  .panel .sub {
    font-size: 12px;
    color: var(--ink-3);
    margin: 0 0 16px;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    height: 140px;
    margin: 0;
    padding: 6px 0 0;
    list-style: none;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    height: 100%;
    justify-content: flex-end;
  }
  .bar {
    width: 100%;
    max-width: 46px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .seg {
    display: block;
    width: 100%;
  }
  .seg:first-child {
    border-radius: 4px 4px 0 0;
  }
  .seg.pub {
    background: var(--accent);
  }
  .seg.rev {
    background: var(--warn);
  }
  .seg.pre {
    background: repeating-linear-gradient(45deg, var(--ink-3) 0 3px, transparent 3px 6px);
    border: 1px solid var(--ink-3);
  }
  .bar-col .yr,
  .bar-col .n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .bar-col .n {
    color: var(--ink-2);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }
  .sw.pub {
    background: var(--accent);
  }
  .sw.rev {
    background: var(--warn);
  }
  .sw.pre {
    background: repeating-linear-gradient(45deg, var(--ink-3) 0 2px, transparent 2px 4px);
    border: 1px solid var(--ink-3);
  }
</style>
